    local labelColor = deriveTextColors(data.Content)

    local swatch = Instance.new("TextButton")
    swatch.Name = themeName .. "Swatch"
    swatch.Size = UDim2.new(0, CELL_W, 0, CELL_H)
    swatch.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    swatch.Text = ""
    swatch.AutoButtonColor = false
    swatch.BorderSizePixel = 0
    swatch.LayoutOrder = orderIndex
    swatch.Parent = grid

    local swCorner = Instance.new("UICorner")
    swCorner.CornerRadius = UDim.new(0, 8)
    swCorner.Parent = swatch

    local swGradient = Instance.new("UIGradient")
    swGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, data.PanelTop),
        ColorSequenceKeypoint.new(1, data.PanelBottom),
    })
    swGradient.Rotation = 135
    swGradient.Parent = swatch

    local swStroke = Instance.new("UIStroke")
    swStroke.Color = data.AccentSoft
    swStroke.Thickness = 1
    swStroke.Transparency = 0.7
    swStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    swStroke.Parent = swatch

    local swLabel = Instance.new("TextLabel")
    swLabel.Size = UDim2.new(1, -30, 0, 16)
    swLabel.Position = UDim2.new(0, 14, 1, -14)
    swLabel.AnchorPoint = Vector2.new(0, 1)
    swLabel.BackgroundTransparency = 1
    swLabel.Text = (themeName == "NewOriginal") and "New Original" or themeName
    swLabel.TextColor3 = labelColor
    swLabel.TextSize = 13
    swLabel.Font = Enum.Font.GothamBold
    swLabel.TextXAlignment = Enum.TextXAlignment.Left
    swLabel.Parent = swatch

    local swDot = Instance.new("Frame")
    swDot.Size = UDim2.new(0, 10, 0, 10)
    swDot.Position = UDim2.new(1, -16, 0, 16)
    swDot.AnchorPoint = Vector2.new(1, 0)
    swDot.BackgroundColor3 = data.Accent
    swDot.BorderSizePixel = 0
    swDot.Parent = swatch

    local swDotCorner = Instance.new("UICorner")
    swDotCorner.CornerRadius = UDim.new(1, 0)
    swDotCorner.Parent = swDot

    themeSwatches[themeName] = { button = swatch, stroke = swStroke, label = swLabel, dot = swDot }

    swatch.MouseButton1Click:Connect(function()
        if applyTheme then
            pcall(applyTheme, themeName)
            saveConfig({ theme = themeName })
        end
    end)
    swatch.MouseEnter:Connect(function()
        if currentThemeName == themeName then return end
        TweenService:Create(swStroke, TweenInfo.new(0.15), {Transparency = 0.4}):Play()
    end)
    swatch.MouseLeave:Connect(function()
        if currentThemeName == themeName then return end
        TweenService:Create(swStroke, TweenInfo.new(0.15), {Transparency = 0.7}):Play()
    end)
end

