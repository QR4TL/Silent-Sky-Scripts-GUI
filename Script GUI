local espState = {
    enabled = false,
    tracers = false,
    instances = {},
    tracerInstances = {},
    folder = Instance.new("Folder"),
    hasDrawingAPI = false,
}
espState.folder.Name = "SilentSkyESP"
espState.folder.Parent = workspace

pcall(function()
    if Drawing and Drawing.new then
        local test = Drawing.new("Line")
        test:Remove()
        espState.hasDrawingAPI = true
    end
end)

local function getESPColor()
    local a = Theme.Accent
    if luminance(a) < 0.25 then
        return offsetRGB(a, 150, 150, 150)
    end
    return a
end

local function refreshESPColors()
    local color = getESPColor()
    for _, highlight in pairs(espState.instances) do
        highlight.FillColor = color
        highlight.OutlineColor = color
    end
    for _, line in pairs(espState.tracerInstances) do
        line.Color = color
    end
end

local function createESP(plr)
    if plr == player or espState.instances[plr] then return end
    local char = plr.Character
    if not char then return end
    local color = getESPColor()
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_" .. plr.Name
    highlight.Adornee = char
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = espState.folder
    espState.instances[plr] = highlight
end

local function removeESP(plr)
    if espState.instances[plr] then
        pcall(function() espState.instances[plr]:Destroy() end)
        espState.instances[plr] = nil
    end
end

local function createTracer(plr)
    if plr == player or espState.tracerInstances[plr] or not espState.hasDrawingAPI then return end
    local line = Drawing.new("Line")
    line.Thickness = 1.5
    line.Color = getESPColor()
    line.Transparency = 1
    line.Visible = false
    espState.tracerInstances[plr] = line
end

local function removeTracer(plr)
    if espState.tracerInstances[plr] then
        pcall(function() espState.tracerInstances[plr]:Remove() end)
        espState.tracerInstances[plr] = nil
    end
end

local function refreshAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then createESP(p) end
    end
end

local function refreshAllTracers()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then createTracer(p) end
    end
end

local function hookPlayer(p)
    if p == player then return end
    p.CharacterAdded:Connect(function()
        task.wait(0.3)
        if espState.enabled then createESP(p) end
        if espState.tracers then createTracer(p) end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= player then hookPlayer(p) end
end

Players.PlayerAdded:Connect(function(p) if p ~= player then hookPlayer(p) end end)
Players.PlayerRemoving:Connect(function(p) removeESP(p); removeTracer(p) end)

RunService.RenderStepped:Connect(function()
    if not espState.hasDrawingAPI or next(espState.tracerInstances) == nil then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local origin = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    for plr, line in pairs(espState.tracerInstances) do
        local char = plr.Character
        if not char then
            line.Visible = false
        else
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then
                line.Visible = false
            else
                local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    line.From = origin
                    line.To = Vector2.new(screenPos.X, screenPos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            end
        end
    end
end)

registerCommand("esp", function(args)
    if #args == 0 then
        espState.enabled = not espState.enabled
        if espState.enabled then refreshAllESP(); return true, "ESP enabled" else
            for plr in pairs(espState.instances) do removeESP(plr) end
            return true, "ESP disabled"
        end
    end
    local targets = resolvePlayers(table.concat(args, " "))
    if #targets == 0 then return false, "No players matched" end
    for _, p in ipairs(targets) do
        if p ~= player then
            if espState.instances[p] then removeESP(p) else createESP(p) end
        end
    end
    return true, ("ESP toggled for %d"):format(#targets)
end)

registerCommand("unesp", function(args)
    if #args == 0 then
        espState.enabled = false
        for plr in pairs(espState.instances) do removeESP(plr) end
        return true, "ESP disabled"
    end
    local targets = resolvePlayers(table.concat(args, " "))
    for _, p in ipairs(targets) do removeESP(p) end
    return true, ("ESP removed for %d"):format(#targets)
end)

registerCommand("trace", function(args)
    if not espState.hasDrawingAPI then return false, "Drawing API not available" end
    if #args == 0 then
        espState.tracers = not espState.tracers
        if espState.tracers then refreshAllTracers(); return true, "Tracers enabled" else
            for plr in pairs(espState.tracerInstances) do removeTracer(plr) end
            return true, "Tracers disabled"
        end
    end
    local targets = resolvePlayers(table.concat(args, " "))
    for _, p in ipairs(targets) do
        if p ~= player then
            if espState.tracerInstances[p] then removeTracer(p) else createTracer(p) end
        end
    end
    return true, ("Tracers toggled for %d"):format(#targets)
end)

registerCommand("untrace", function(args)
    if not espState.hasDrawingAPI then return false, "Drawing API not available" end
    if #args == 0 then
        espState.tracers = false
        for plr in pairs(espState.tracerInstances) do removeTracer(plr) end
