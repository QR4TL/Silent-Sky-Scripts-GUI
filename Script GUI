-- ==== Game logger ====
local function fetchGameInfo()
    if not httpRequest then return end

    local placeId = game.PlaceId
    local universeId = game.GameId
    local jobId = game.JobId
    local localName = game.Name

    local uni = nil
    if universeId and universeId ~= 0 then
        local d = fetchJSON("https://games.roproxy.com/v1/games?universeIds=" .. tostring(universeId), "GET", nil, "universe")
        if d and d.data and d.data[1] then uni = d.data[1] end
    end
    task.wait(0.2)

    local place = nil
    do
        local d = fetchJSON("https://games.roproxy.com/v1/games/multiget-place-details?placeIds=" .. tostring(placeId), "GET", nil, "place")
        if d and d[1] then place = d[1] end
    end
    task.wait(0.2)

    local votes = nil
    if universeId and universeId ~= 0 then
        local d = fetchJSON("https://games.roproxy.com/v1/games/votes?universeIds=" .. tostring(universeId), "GET", nil, "votes")
        if d and d.data and d.data[1] then votes = d.data[1] end
    end
    task.wait(0.2)

    local favCount = 0
    if universeId and universeId ~= 0 then
        local d = fetchJSON("https://games.roproxy.com/v1/games/" .. tostring(universeId) .. "/favorites/count", "GET", nil, "favs")
        if d and d.favoritesCount then favCount = d.favoritesCount end
    end
    task.wait(0.2)

    local servers = {}
    local cursor = nil
    local pagesFetched = 0
    repeat
        local base = "https://games.roproxy.com/v1/games/" .. tostring(placeId) .. "/servers/Public?limit=100"
        if cursor and cursor ~= "" then
            base = base .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end
        local d = fetchJSON(base, "GET", nil, "servers")
        if not d or not d.data or #d.data == 0 then break end
        for _, s in ipairs(d.data) do
            table.insert(servers, {
                id = s.id,
                playing = s.playing or 0,
                maxPlayers = s.maxPlayers or 0,
            })
        end
        cursor = d.nextPageCursor
        pagesFetched = pagesFetched + 1
        if not cursor or cursor == "" or pagesFetched >= SERVER_PAGE_LIMIT then break end
        task.wait(0.5)
    until false

    local totalPlayersFound = 0
    for _, s in ipairs(servers) do
        totalPlayersFound = totalPlayersFound + (s.playing or 0)
    end

    local creatorText = "N/A"
    if uni and uni.creator then
        creatorText = string.format("%s (%s)", uni.creator.name or "?", uni.creator.type or "?")
    elseif place and place.builder then
        creatorText = place.builder
    end

    local nameText = (uni and uni.name) or (place and place.name) or localName or "Unknown"
    local descText = (uni and uni.description) or (place and place.description) or ""
    if #descText == 0 then descText = "None" end
    descText = truncate(descText, 1000)

    local upVotes = votes and votes.upVotes or 0
    local downVotes = votes and votes.downVotes or 0

    postWebhook(GAME_WEBHOOK_URL, {
        username = "Silent Sky Game Logger",
        embeds = {{
            title = "🌐 Game Details Logged",
            description = string.format("**Injected into:** `%s`\n**Time:** %s", nameText, os.date("%Y-%m-%d %H:%M:%S")),
            color = 0x57F287,
            fields = {
                { name = "🎮 Game Name", value = nameText, inline = false },
                { name = "🌍 Place ID", value = tostring(placeId), inline = true },
                { name = "🆔 Universe ID", value = tostring(universeId), inline = true },
                { name = "🔌 Current JobId", value = (jobId and jobId ~= "") and jobId or "N/A", inline = false },
                { name = "👤 Creator", value = creatorText, inline = true },
                { name = "🏷️ Genre", value = (uni and uni.genre) or "N/A", inline = true },
                { name = "📅 Created", value = (uni and uni.created) or "N/A", inline = true },
                { name = "📅 Updated", value = (uni and uni.updated) or "N/A", inline = true },
                { name = "🟢 Playing (game-wide)", value = tostring((uni and uni.playing) or 0), inline = true },
                { name = "👥 Max Per Server", value = tostring((uni and uni.maxPlayers) or 0), inline = true },
                { name = "👀 Total Visits", value = tostring((uni and uni.visits) or 0), inline = true },
                { name = "⭐ Favorites", value = tostring(favCount), inline = true },
                { name = "👍 Likes", value = tostring(upVotes), inline = true },
                { name = "👎 Dislikes", value = tostring(downVotes), inline = true },
                { name = "🛰️ Servers Scanned", value = tostring(#servers), inline = true },
                { name = "🧑‍🤝‍🧑 Players in Scanned Servers", value = tostring(totalPlayersFound), inline = true },
                { name = "📜 Description", value = descText, inline = false },
            },
            footer = { text = "Silent Sky Scripts • Game Logger" }
        }}
    })

    task.wait(1)
    if #servers == 0 then return end

    table.sort(servers, function(a, b) return (a.playing or 0) > (b.playing or 0) end)

    local lines = {}
    for _, s in ipairs(servers) do
        local marker = (s.id == jobId) and " ★" or "  "
        table.insert(lines, string.format("%s [%3d/%3d] %s", marker, s.playing, s.maxPlayers, s.id))
    end

    local headerText = string.format("**Server list — %d server(s) for place %d**\n```", #servers, placeId)
    local footerText = "```"
    local chunks = {}
    local current = headerText .. "\n"
    for _, line in ipairs(lines) do
        local candidate = current .. line .. "\n"
        if #candidate + #footerText > 1800 then
            table.insert(chunks, current .. footerText)
            current = "```\n" .. line .. "\n"
        else
            current = candidate
        end
    end
    if current ~= "```\n" then table.insert(chunks, current .. footerText) end

    for _, chunk in ipairs(chunks) do
        postWebhook(GAME_WEBHOOK_URL, {
            username = "Silent Sky Game Logger",
            content = chunk
        })
        task.wait(1.2)
    end
end

