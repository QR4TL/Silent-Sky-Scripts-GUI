-- ==== CONFIG PERSISTENCE ====
local hasFileAPI = (type(writefile) == "function") and (type(readfile) == "function") and (type(isfile) == "function")

local function loadConfig()
    if not hasFileAPI then return nil end
    local ok, result = pcall(function()
        if isfile(CONFIG_FILE_NAME) then
            local contents = readfile(CONFIG_FILE_NAME)
            if contents and #contents > 0 then
                return HttpService:JSONDecode(contents)
            end
        end
        return nil
    end)
    if ok then return result end
    return nil
end

local savedConfig = loadConfig()

local function saveConfig(cfg)
    if not hasFileAPI then return false end
    local merged = {}
    if savedConfig then
        for k, v in pairs(savedConfig) do merged[k] = v end
    end
    for k, v in pairs(cfg) do merged[k] = v end
    savedConfig = merged
    local ok = pcall(function()
        writefile(CONFIG_FILE_NAME, HttpService:JSONEncode(merged))
    end)
    return ok
end

