local function parseRGB(boxes)
    local r = tonumber(boxes[1].Text)
    local g = tonumber(boxes[2].Text)
    local b = tonumber(boxes[3].Text)
    if not r or not g or not b then return nil end
    return Color3.fromRGB(
        math.clamp(math.floor(r), 0, 255),
        math.clamp(math.floor(g), 0, 255),
        math.clamp(math.floor(b), 0, 255))
end

local function updatePreview()
    local bg = parseRGB(bgBoxes)
    local accent = parseRGB(accentBoxes)
    if not bg or not accent then
        customPanelGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.PanelTop),
            ColorSequenceKeypoint.new(1, Theme.PanelBottom),
        })
        customPanelStroke.Color = Theme.AccentSoft
        applyBtn.BackgroundColor3 = Theme.Accent
        return
    end
    local pal = buildCustomPalette(bg, accent)
    customPanelGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, pal.PanelTop),
        ColorSequenceKeypoint.new(1, pal.PanelBottom),
    })
    customPanelStroke.Color = pal.Accent
    applyBtn.BackgroundColor3 = pal.Accent
end

for _, box in ipairs(bgBoxes) do
    box:GetPropertyChangedSignal("Text"):Connect(updatePreview)
end
for _, box in ipairs(accentBoxes) do
    box:GetPropertyChangedSignal("Text"):Connect(updatePreview)
end

