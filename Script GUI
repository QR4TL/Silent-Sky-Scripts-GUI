local function createFlyController()
    local state = {
        enabled = false,
        bv = nil,
        bg = nil,
        conn = nil,
    }
    local function setOn(on)
        state.enabled = on and true or false
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if state.conn then state.conn:Disconnect(); state.conn = nil end
        if state.bv then state.bv:Destroy(); state.bv = nil end
        if state.bg then state.bg:Destroy(); state.bg = nil end
        if not state.enabled or not hrp then return end
        state.bv = Instance.new("BodyVelocity")
        state.bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        state.bv.Velocity = Vector3.zero
        state.bv.Parent = hrp
        state.bg = Instance.new("BodyGyro")
        state.bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        state.bg.P = 10000
        state.bg.D = 500
        state.bg.CFrame = hrp.CFrame
        state.bg.Parent = hrp
        local speed = 60
        state.conn = RunService.RenderStepped:Connect(function()
            if not state.enabled then return end
            local c = player.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if not h or not state.bv or not state.bg then return end
            local cam = workspace.CurrentCamera
            local look  = cam.CFrame.LookVector
            local right = cam.CFrame.RightVector
            local up    = Vector3.new(0, 1, 0)
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
            if UserInputService:IsKeyDown(Enum.KeyCode.E)
                or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                dir = dir + up
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.Q)
                or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                dir = dir - up
            end
            if dir.Magnitude > 0 then dir = dir.Unit * speed end
            state.bv.Velocity = dir
            state.bg.CFrame = cam.CFrame
        end)
    end
    return state, setOn
end

local flyState, setFly             = createFlyController()
local toggleFlyState, setToggleFly = createFlyController()

local function setNoclip(on)
    cmdState.noclipEnabled = on and true or false
    if cmdState.noclipConn then cmdState.noclipConn:Disconnect(); cmdState.noclipConn = nil end
    if not cmdState.noclipEnabled then return end
    cmdState.noclipConn = RunService.Stepped:Connect(function()
        if not cmdState.noclipEnabled then return end
        local c = player.Character
        if not c then return end
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then d.CanCollide = false end
        end
    end)
end

local function applyInvis(char)
    if not char or not cmdState.invisEnabled then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") then d.Transparency = 1
        elseif d:IsA("Decal") then d.Transparency = 1 end
    end
end
local function setInvis(on)
    cmdState.invisEnabled = on and true or false
    if cmdState.invisConn then cmdState.invisConn:Disconnect(); cmdState.invisConn = nil end
    local char = player.Character
    if cmdState.invisEnabled then
        applyInvis(char)
        if char then cmdState.invisConn = char.DescendantAdded:Connect(applyInvis) end
    elseif char then
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then d.Transparency = 0
            elseif d:IsA("Decal") then d.Transparency = 0 end
        end
    end
end

local function setFollow(target)
    cmdState.followTarget = target
    if cmdState.followConn then cmdState.followConn:Disconnect(); cmdState.followConn = nil end
    if not target then return end
    cmdState.followConn = RunService.RenderStepped:Connect(function()
        if not cmdState.followTarget then return end
        local myChar = player.Character
        local myHrp  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local tChar  = cmdState.followTarget.Character
        local tHrp   = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not myHrp or not tHrp then return end
        local dist = (myHrp.Position - tHrp.Position).Magnitude
        if dist > 8 then
            myHrp.CFrame = CFrame.new(tHrp.Position) * CFrame.new(0, 3, -4)
        end
    end)
end

