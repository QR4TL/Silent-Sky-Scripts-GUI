local function selectTab(name)
    if gamePageOverlay then
        gamePageOverlay.Visible = false
        ui.sidebar.Visible = true
        ui.pageHolder.Visible = true
    end

    if not tabs[name] or activeTab == name then return end
    local previous = activeTab
    activeTab = name
    for _, tabName in ipairs(tabOrder) do
        if tabs[tabName] then tabs[tabName].setActive(tabName == name) end
    end
    local targetPosition = UDim2.new(0, 5, 0, tabs[name].centerY)
    if previous == nil then
        ui.accentBar.Position = targetPosition
        TweenService:Create(ui.accentBar, TweenInfo.new(0.25), { BackgroundTransparency = 0 }):Play()
    else
        TweenService:Create(ui.accentBar, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = targetPosition }):Play()
    end
end

