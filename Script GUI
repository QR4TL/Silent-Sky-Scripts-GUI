local commandHistory = {}
local historyIndex = 0

local function pushHistory(cmd)
    if cmd == "" or commandHistory[#commandHistory] == cmd then return end
    table.insert(commandHistory, cmd)
    if #commandHistory > 100 then table.remove(commandHistory, 1) end
end

UserInputService.InputBegan:Connect(function(input)
    if UserInputService:GetFocusedTextBox() ~= ui.floatBox then return end
    if input.KeyCode == Enum.KeyCode.Up then
        if #commandHistory == 0 then return end
        historyIndex = math.max(1, historyIndex - 1)
        ui.floatBox.Text = commandHistory[historyIndex]
        ui.floatBox.CursorPosition = #ui.floatBox.Text + 1
    elseif input.KeyCode == Enum.KeyCode.Down then
        if #commandHistory == 0 then return end
        historyIndex = math.min(#commandHistory + 1, historyIndex + 1)
        if historyIndex > #commandHistory then ui.floatBox.Text = ""
        else ui.floatBox.Text = commandHistory[historyIndex] end
        ui.floatBox.CursorPosition = #ui.floatBox.Text + 1
    elseif input.KeyCode == Enum.KeyCode.Tab then
        local text = ui.floatBox.Text:lower()
        if text == "" then return end
        for canonical in pairs(commandDefs) do
            if canonical:sub(1, #text) == text then
                ui.floatBox.Text = canonical
                ui.floatBox.CursorPosition = #canonical + 1
                return
            end
        end
        for alias, canonical in pairs(commandAliases) do
            if alias:sub(1, #text) == text and not commandDefs[alias] then
                ui.floatBox.Text = canonical
                ui.floatBox.CursorPosition = #canonical + 1
                return
            end
        end
    end
end)

