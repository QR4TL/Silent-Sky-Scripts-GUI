local function luminance(c) return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B end
local function deriveTextColors(bg)
    if luminance(bg) > 0.5 then
        return Color3.fromRGB(15, 15, 15), Color3.fromRGB(80, 80, 80)
    else
        return Color3.fromRGB(245, 245, 245), Color3.fromRGB(180, 180, 180)
    end
end

local function offsetRGB(c, dr, dg, db)
    return Color3.fromRGB(
        math.clamp(math.floor(c.R * 255 + 0.5) + dr, 0, 255),
        math.clamp(math.floor(c.G * 255 + 0.5) + dg, 0, 255),
        math.clamp(math.floor(c.B * 255 + 0.5) + db, 0, 255))
end

local function buildCustomPalette(bg, accent)
    return {
        PanelTop = offsetRGB(bg, 8, 6, 14), PanelBottom = offsetRGB(bg, -10, -10, -14),
        Header = offsetRGB(bg, 4, 3, 6), Content = offsetRGB(bg, -2, -2, -4),
        Accent = accent, AccentSoft = offsetRGB(accent, -50, -50, -50),
        Close = Color3.fromRGB(220, 80, 100), CloseHover = Color3.fromRGB(240, 105, 125),
        Min = offsetRGB(bg, 40, 40, 45), MinHover = offsetRGB(bg, 65, 65, 70),
    }
end

