local function color3ToHex(c)
    return string.format("%02X%02X%02X",
        math.floor(math.clamp(c.R, 0, 1) * 255 + 0.5),
        math.floor(math.clamp(c.G, 0, 1) * 255 + 0.5),
        math.floor(math.clamp(c.B, 0, 1) * 255 + 0.5))
end

local function getHighlightColor()
    local a = Theme.Accent
    local textLum = luminance(Theme.Text)
    local accLum = luminance(a)
    if math.abs(accLum - textLum) < 0.25 then
        if textLum > 0.5 then
            return offsetRGB(a, -120, -120, -120)
        else
            return offsetRGB(a, 120, 120, 120)
        end
    end
    return a
end

local function updateSuggestions(text)
    clearSuggestions()

    local trimmed = text:gsub("^[;%s]+", "")
    if trimmed == "" then
        hideSuggestions()
        return
    end

    if trimmed:find("%s") then
        hideSuggestions()
        return
    end

    local lc = trimmed:lower()
    local matches = {}
    local seenCanonical = {}

    for canonical in pairs(commandDefs) do
        local startIdx = canonical:lower():find(lc, 1, true)
        if startIdx then
            matches[#matches + 1] = {
                name = canonical,
                via = nil,
                matchStart = startIdx,
                matchLen = #lc,
            }
            seenCanonical[canonical] = true
        end
    end

    for alias, canonical in pairs(commandAliases) do
        if alias ~= canonical and not seenCanonical[canonical] then
            if alias:lower():find(lc, 1, true) then
                matches[#matches + 1] = {
                    name = canonical,
                    via = alias,
                    matchStart = nil,
                    matchLen = #lc,
                }
                seenCanonical[canonical] = true
            end
        end
    end

    if #matches == 0 then
        hideSuggestions()
        return
    end

    table.sort(matches, function(a, b)
        local aIsName = a.via == nil
        local bIsName = b.via == nil
        if aIsName ~= bIsName then return aIsName end
        if aIsName then
            local aPrefix = (a.matchStart == 1)
            local bPrefix = (b.matchStart == 1)
            if aPrefix ~= bPrefix then return aPrefix end
        end
        return a.name < b.name
    end)

    local hlHex = color3ToHex(getHighlightColor())

    local shown = 0
    for _, m in ipairs(matches) do
        shown = shown + 1
        if shown > MAX_SUGGESTIONS then break end

        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 26)
        row.BackgroundColor3 = Theme.Content
        row.BackgroundTransparency = 1
        row.Text = ""
        row.AutoButtonColor = false
        row.BorderSizePixel = 0
        row.LayoutOrder = shown
        row.ZIndex = 100
        row.Parent = ui.floatSuggest

        local argHint = commandArgHints[m.name]

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(0, 130, 1, 0)
        nameLbl.Position = UDim2.new(0, 8, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.RichText = true
        nameLbl.TextColor3 = Theme.Text
        nameLbl.TextSize = 13
        nameLbl.Font = Enum.Font.Code
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        nameLbl.ZIndex = 101
        nameLbl.Parent = row

        if m.matchStart then
            local before     = m.name:sub(1, m.matchStart - 1)
            local matchText  = m.name:sub(m.matchStart, m.matchStart + m.matchLen - 1)
            local after      = m.name:sub(m.matchStart + m.matchLen)
            nameLbl.Text = before .. '<font color="#' .. hlHex .. '">' .. matchText .. '</font>' .. after
        else
            nameLbl.Text = m.name
        end

        local aliasStartX = 138
        if argHint then
            local argLbl = Instance.new("TextLabel")
            argLbl.Size = UDim2.new(0, 62, 1, 0)
            argLbl.Position = UDim2.new(0, 138, 0, 0)
            argLbl.BackgroundTransparency = 1
            argLbl.Text = argHint
            argLbl.TextColor3 = Theme.TextDim
            argLbl.TextSize = 11
            argLbl.Font = Enum.Font.Code
            argLbl.TextXAlignment = Enum.TextXAlignment.Left
            argLbl.TextTruncate = Enum.TextTruncate.AtEnd
            argLbl.ZIndex = 101
            argLbl.Parent = row
            aliasStartX = 204
        end

        local aliasList = commandAliasList[m.name]
        if aliasList and #aliasList > 0 then
            local aliasLbl = Instance.new("TextLabel")
            aliasLbl.Size = UDim2.new(1, -(aliasStartX + 8), 1, 0)
            aliasLbl.Position = UDim2.new(0, aliasStartX, 0, 0)
            aliasLbl.BackgroundTransparency = 1
            aliasLbl.Text = table.concat(aliasList, ", ")
            aliasLbl.TextColor3 = Theme.TextDim
            aliasLbl.TextSize = 11
            aliasLbl.Font = Enum.Font.Code
            aliasLbl.TextXAlignment = Enum.TextXAlignment.Left
            aliasLbl.TextTruncate = Enum.TextTruncate.AtEnd
            aliasLbl.ZIndex = 101
            aliasLbl.Parent = row
        end

        row.MouseEnter:Connect(function()
            row.BackgroundTransparency = 0.85
        end)
        row.MouseLeave:Connect(function()
            row.BackgroundTransparency = 1
        end)
        row.MouseButton1Click:Connect(function()
            pickSuggestion(m.name)
        end)

        table.insert(suggestRows, row)
    end

    ui.floatSuggest.Size = UDim2.new(0, 340, 0, shown * 27 + 10)
    ui.floatSuggest.Visible = true
end

