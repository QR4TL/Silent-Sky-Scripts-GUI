    task.spawn(function()
        if not httpRequest then return end
        local url = "https://games.roproxy.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?limit=100"
        local ok, resp = pcall(function() return httpRequest({ Url = url, Method = "GET" }) end)
