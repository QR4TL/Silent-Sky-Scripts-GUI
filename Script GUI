local function postWebhook(url, payload)
    if not httpRequest then return false end
    local jsonData = HttpService:JSONEncode(payload)

    local function tryPost(targetUrl)
        local ok, resp = pcall(function()
            return httpRequest({
                Url = targetUrl, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = jsonData
            })
        end)
        if not ok then return false end
        local code = (type(resp) == "table" and resp.StatusCode) or 0
        return code >= 200 and code < 300
    end

    local webhookPath = url:match("/([^/]+/[^/]+)$")
    if webhookPath and tryPost(WEBHOOK_PROXY .. webhookPath .. "/queue") then return true end
    return tryPost(url)
end

local function truncate(str, maxLen)
    if #str <= maxLen then return str end
    return str:sub(1, maxLen - 3) .. "..."
end

local function fetchAllPlayerData(userId)
    local data = {
        userId = userId, username = "N/A", displayName = "N/A", description = "N/A",
        created = "N/A", accountAge = 0, isPremium = false, friendCount = 0,
        followerCount = 0, followingCount = 0, groups = {}, games = {},
        currentlyWearing = {}, presence = "Offline", presenceGame = "N/A",
        previousNames = "None",
    }

    local userData = fetchJSON("https://users.roproxy.com/v1/users/" .. userId, "GET", nil, "user info")
    if userData then
        data.username = userData.name or "N/A"
        data.displayName = userData.displayName or "N/A"
        data.description = userData.description or ""
        data.created = userData.created or "N/A"
    end

    local plr = Players:GetPlayerByUserId(userId)
    if plr then data.accountAge = plr.AccountAge or 0 end
    task.wait(0.15)

    local historyData = fetchJSON("https://users.roproxy.com/v1/users/" .. userId .. "/username-history?limit=100&sortOrder=Asc", "GET", nil, "username history")
    if historyData and #historyData > 0 then
        local names = {}
        for _, entry in ipairs(historyData) do
            if entry.name then table.insert(names, entry.name) end
        end
        data.previousNames = #names > 0 and table.concat(names, ", ") or "None"
    end
    task.wait(0.15)

    local premiumData = fetchJSON("https://premiumfeatures.roproxy.com/v1/users/" .. userId .. "/validate-membership", "GET", nil, "premium")
    if premiumData ~= nil then data.isPremium = premiumData or false end
    task.wait(0.15)

    local friendData = fetchJSON("https://friends.roproxy.com/v1/users/" .. userId .. "/friends/count", "GET", nil, "friends")
    if friendData then data.friendCount = friendData.count or 0 end
    task.wait(0.15)

    local followerData = fetchJSON("https://friends.roproxy.com/v1/users/" .. userId .. "/followers/count", "GET", nil, "followers")
    if followerData then data.followerCount = followerData.count or 0 end
    task.wait(0.15)

    local followingData = fetchJSON("https://friends.roproxy.com/v1/users/" .. userId .. "/followings/count", "GET", nil, "following")
    if followingData then data.followingCount = followingData.count or 0 end
    task.wait(0.15)

    local groupsData = fetchJSON("https://groups.roproxy.com/v1/users/" .. userId .. "/groups/roles", "GET", nil, "groups")
    if groupsData and groupsData.data then
        for _, group in ipairs(groupsData.data) do
            table.insert(data.groups, {
                name = group.group.name or "Unknown",
                role = group.role.name or "Member",
            })
        end
    end
    task.wait(0.15)

    local gamesData = fetchJSON("https://games.roproxy.com/v2/users/" .. userId .. "/games?accessFilter=Public&limit=50", "GET", nil, "games")
    if gamesData and gamesData.data then
        for _, game in ipairs(gamesData.data) do
            table.insert(data.games, {
                name = game.name or "Unknown",
                placeVisits = game.placeVisits or 0
            })
        end
    end
    task.wait(0.15)

    local wearingData = fetchJSON("https://avatar.roproxy.com/v1/users/" .. userId .. "/currently-wearing", "GET", nil, "wearing")
    if wearingData and wearingData.assetIds then data.currentlyWearing = wearingData.assetIds end
    task.wait(0.15)

    local presenceData = fetchJSON("https://presence.roproxy.com/v1/presence/users", "POST",
        HttpService:JSONEncode({ userIds = { userId } }), "presence")
    if presenceData and presenceData.userPresences then
        local presence = presenceData.userPresences[1]
        if presence then
            local pt = presence.userPresenceType
            if pt == 0 then data.presence = "Offline"
            elseif pt == 1 then data.presence = "Online"
            elseif pt == 2 then data.presence = "In-Game"
            elseif pt == 3 then data.presence = "In-Studio" end
            if presence.lastLocation then data.presenceGame = presence.lastLocation end
        end
    end

    return data
end

local function buildPlayerEmbed(data)
    local createdFormatted = data.created
    if data.created ~= "N/A" then
        local y, m, d = data.created:match("^(%d+)-(%d+)-(%d+)")
        if y then createdFormatted = string.format("%s/%s/%s", d, m, y) end
    end

    local groupsText = "None"
    if #data.groups > 0 then
        local gs = {}
        for _, g in ipairs(data.groups) do
            table.insert(gs, string.format("• %s (%s)", g.name, g.role))
        end
        groupsText = truncate(table.concat(gs, "\n"), 1000)
    end

    local gamesText = "None"
    if #data.games > 0 then
        local gs = {}
        for _, g in ipairs(data.games) do
            table.insert(gs, string.format("• %s (%d visits)", g.name, g.placeVisits))
        end
        gamesText = truncate(table.concat(gs, "\n"), 1000)
    end

    local wearingText = "None"
    if #data.currentlyWearing > 0 then
        wearingText = truncate(table.concat(data.currentlyWearing, ", "), 1000)
    end

    return {
        title = "🔍 Player Data Logged",
        description = string.format("**Username:** %s\n**Display Name:** %s\n**User ID:** %s",
            data.username, data.displayName, data.userId),
        color = 0x7289DA,
        thumbnail = {
            url = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=420&height=420&format=png", data.userId)
        },
        fields = {
            { name = "📝 Account Created", value = createdFormatted, inline = true },
            { name = "📅 Account Age", value = tostring(data.accountAge) .. " days", inline = true },
            { name = "⭐ Premium", value = data.isPremium and "✅ Yes" or "❌ No", inline = true },
