-- ============================================================
--  HTTP FETCHER
-- ============================================================
local function hostFallbacks(url)
    local direct = url:gsub("%.roproxy%.com", ".roblox.com")
    if direct ~= url then return { url, direct } end
    return { url }
end

local function tryRequestJSON(url, method, body)
    if not httpRequest then return nil, "no httpRequest" end
    local ok, resp = pcall(function()
        return httpRequest({ Url = url, Method = method or "GET",
            Headers = { ["Content-Type"] = "application/json" }, Body = body })
    end)
    if not ok then return nil, "threw: " .. tostring(resp) end
    local code = (type(resp) == "table" and resp.StatusCode) or 0
    if code ~= 200 then return nil, "HTTP " .. tostring(code) end
    local decOk, dec = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    if not decOk then return nil, "decode failed" end
    return dec
end

local function fetchJSON(url, method, body, label)
    for _, u in ipairs(hostFallbacks(url)) do
        local dec = tryRequestJSON(u, method, body)
        if dec ~= nil then return dec end
    end
    if DEBUG_HTTP then warn(("[Silent Sky] %s failed"):format(label or "fetchJSON")) end
    return nil
end

