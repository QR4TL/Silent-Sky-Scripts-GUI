--[[
    Corsa Legends — Fast Spiral Sweep + Auto Pumpkin Collector
    ---------------------------------------------------------
    • Glides along an Archimedean spiral at high speed (Heartbeat
      interpolated, so motion stays smooth even at 2000 studs/s).
    • Streaming requests are fired in task.spawn so they never block
      the Heartbeat thread.
    • Pauses on pumpkin detection → collects → resumes spiral.
]]

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace         = game:GetService("Workspace")
local RunService        = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- ── Config ─────────────────────────────────────────────────
local CONFIG = {
    -- Collection
    FireDelay       = 0.35,
    RetryDelay      = 0.15,
    HeightOffset    = 5,
    TeleportToEach  = true,

    -- Flight / spiral
    FlightHeight    = 8,
    FlightRayStart  = 500,
    SpiralStep      = 50,          -- point density along curve (higher = fewer pts, fine at speed)
    SpiralSpacing   = 350,         -- studs between turns (keep < 512 for streaming coverage)
    FlightSpeed     = 2000,        -- studs per second — way faster

    -- Streaming
    RequestTimeout  = 4,
    StreamInterval  = 0.04,        -- seconds between streaming calls

    -- Bounds
    MapCenter       = Vector2.new(0, 0),
    MapRadius       = 8000,

    -- Loop
    RescanDelay     = 0.5,
}

-- ── Remotes ────────────────────────────────────────────────
local Remotes = ReplicatedStorage:WaitForChild("Remotes", 30)
assert(Remotes, "[Pumpkin] Remotes folder missing")
local Collect = Remotes:WaitForChild("HalloweenPumpkinCollect", 30)
assert(Collect, "[Pumpkin] HalloweenPumpkinCollect remote missing")

-- ── State ──────────────────────────────────────────────────
local running = true
local mode    = "flight"

-- ── Helpers ────────────────────────────────────────────────
local function getHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getPumpkinFolder()
    return Workspace:FindFirstChild("HalloweenPumpkins")
end

local function fireRemote(name)
    local ok, err = pcall(function() Collect:FireServer(name) end)
    if not ok then warn("[Pumpkin] FireServer:", err) end
    return ok
end

local function teleportTo(pos)
    local hrp = getHRP()
    if not hrp then return end
    pcall(function()
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, CONFIG.HeightOffset, 0))
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- ── Ground raycast ─────────────────────────────────────────
local groundRayParams = RaycastParams.new()
groundRayParams.FilterType  = Enum.RaycastFilterType.Exclude
groundRayParams.IgnoreWater = true

local function getGroundY(x, z)
    local filters = {}
    if LocalPlayer.Character then table.insert(filters, LocalPlayer.Character) end
    local folder = getPumpkinFolder()
    if folder then table.insert(filters, folder) end
    groundRayParams.FilterDescendantsInstances = filters

    local origin = Vector3.new(x, CONFIG.FlightRayStart, z)
    local result = Workspace:Raycast(origin, Vector3.new(0, -CONFIG.FlightRayStart * 2, 0), groundRayParams)
    return result and result.Position.Y or nil
end

-- ── Spiral path ────────────────────────────────────────────
local spiral = {
    points = {}, cum = {}, totalLen = 0,
    distance = 0, segIndex = 2, laps = 0,
}

local function buildSpiral()
    local center  = CONFIG.MapCenter
    local radius  = CONFIG.MapRadius
    local spacing = CONFIG.SpiralSpacing
    local stepLen = CONFIG.SpiralStep

    local b = spacing / (2 * math.pi)
    local maxTheta = radius / b

    local pts = {}
    local theta = 0
    local safety = 0
    while theta < maxTheta and safety < 200000 do
        local r = b * theta
        table.insert(pts, Vector2.new(
            center.X + r * math.cos(theta),
            center.Y + r * math.sin(theta)
        ))
        local denom = math.sqrt(b*b + r*r)
        local dtheta = stepLen / denom
        if dtheta < 0.02 then dtheta = 0.02 end
        theta = theta + dtheta
        safety = safety + 1
    end

    local cum = {0}
    for i = 2, #pts do
        cum[i] = cum[i-1] + (pts[i] - pts[i-1]).Magnitude
    end

    spiral.points   = pts
    spiral.cum      = cum
    spiral.totalLen = cum[#cum] or 0
    spiral.distance = 0
    spiral.segIndex = 2
    spiral.laps     = 0

    print(("[Spiral] %d points | %.0f studs/lap | est %.1fs/lap @ %.0f studs/s")
        :format(#pts, spiral.totalLen, spiral.totalLen / CONFIG.FlightSpeed, CONFIG.FlightSpeed))
end

local function posAtDistance(d)
    local pts, cum, n = spiral.points, spiral.cum, #spiral.points
    if n == 0 then return Vector2.new(0, 0) end

    local i = spiral.segIndex
    while i <= n and cum[i] < d do i = i + 1 end
    spiral.segIndex = i
    if i > n then return pts[n] end

    local segLen = cum[i] - cum[i-1]
    local t = segLen > 0 and (d - cum[i-1]) / segLen or 0
    return pts[i-1]:Lerp(pts[i], t)
end

-- ── Glide loop ─────────────────────────────────────────────
buildSpiral()

local lastGroundY    = 0
local lastStreamTime = 0
local lastHeartbeat  = tick()

RunService.Heartbeat:Connect(function()
    local now = tick()
    local dt  = now - lastHeartbeat
    lastHeartbeat = now

    if not running or mode ~= "flight" then return end
    if not getHRP() then return end
    if dt > 0.25 then return end  -- dropped frames: don't jump

    spiral.distance = spiral.distance + CONFIG.FlightSpeed * dt
    if spiral.distance >= spiral.totalLen then
        spiral.distance = spiral.distance - spiral.totalLen
        spiral.segIndex = 2
        spiral.laps = spiral.laps + 1
        print(("[Spiral] Lap %d complete."):format(spiral.laps))
    end

    local wp = posAtDistance(spiral.distance)
    local groundY = getGroundY(wp.X, wp.Y) or lastGroundY
    lastGroundY = groundY
    local target = Vector3.new(wp.X, groundY + CONFIG.FlightHeight, wp.Y)

    local hrp = getHRP()
    if hrp then
        pcall(function()
            hrp.CFrame = CFrame.new(target)
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    if now - lastStreamTime > CONFIG.StreamInterval then
        lastStreamTime = now
        -- task.spawn so RequestStreamAroundAsync (which yields) doesn't block Heartbeat
        task.spawn(function()
            pcall(function()
                Workspace:RequestStreamAroundAsync(target, CONFIG.RequestTimeout)
            end)
        end)
    end
end)

-- ── Collect loop ───────────────────────────────────────────
task.spawn(function()
    print("[Pumpkin] Running. Set `running = false` to stop.")
    repeat task.wait(0.1) until getHRP() or not running

    while running do
        local folder = getPumpkinFolder()
        local pumpkins = {}
        if folder then
            for _, c in ipairs(folder:GetChildren()) do
                if c:IsA("Model") then table.insert(pumpkins, c) end
            end
        end

        if #pumpkins > 0 then
            if mode ~= "collect" then
                mode = "collect"
                print(("[Pumpkin] %d pumpkin(s) loaded — collecting (spiral at %.0f/%.0f)")
                    :format(#pumpkins, spiral.distance, spiral.totalLen))
            end

            for _, pumpkin in ipairs(pumpkins) do
                if not running or mode ~= "collect" then break end
                if not pumpkin.Parent then continue end

                local name = pumpkin.Name
                local pos  = pumpkin:GetPivot().Position

                if CONFIG.TeleportToEach then
                    teleportTo(pos)
                    task.wait(0.08)
                end

                fireRemote(name)
                task.wait(CONFIG.FireDelay)

                if pumpkin.Parent and running then
                    task.wait(CONFIG.RetryDelay)
                    if pumpkin.Parent then
                        fireRemote(name)
                        task.wait(CONFIG.FireDelay)
                    end
                end
            end

            task.wait(CONFIG.RescanDelay)
        else
            if mode ~= "flight" then
                mode = "flight"
                lastHeartbeat = tick()
                print("[Pumpkin] No pumpkins — resuming spiral.")
            end
            task.wait(0.1)
        end
    end
end)
