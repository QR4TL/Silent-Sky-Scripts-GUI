-- Best-effort cleanup when the toggle is turned OFF.
-- IMPORTANT: this must NOT destroy the Corsa Legends sub-window itself,
-- otherwise the game card can't re-open it.
local function corsaPumpkinCleanup()
    _G.CorsaPumpkinFinderEnabled = false
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        for _, child in ipairs(pg:GetChildren()) do
            if child:IsA("ScreenGui") and child.Name ~= SUB_WINDOW_NAME then
                local n = child.Name:lower()
                if n:find("pumpkin") or n:find("corsa") then
                    child:Destroy()
                end
            end
        end
    end
end

