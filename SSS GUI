    rowLabel.TextXAlignment         = Enum.TextXAlignment.Left
    rowLabel.Parent                 = row

    local track = Instance.new("TextButton")
    track.Size             = UDim2.new(0, 40, 0, 22)
    track.Position         = UDim2.new(1, -40, 0.5, 0)
    track.AnchorPoint      = Vector2.new(0, 0.5)
