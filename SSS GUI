local function applyTheme(key)
    local t = Themes[key]
    if not t then return end
    currentTheme = key
    Palette = t

    panel.BackgroundColor3 = t.PanelTop
    panelGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, t.PanelTop),
        ColorSequenceKeypoint.new(1, t.PanelBot),
    })
    panelStroke.Color = t.Stroke

    header.BackgroundColor3        = t.Header
    headerFlatten.BackgroundColor3 = t.Header
    headerDivider.BackgroundColor3 = t.Stroke
    accentDot.BackgroundColor3     = t.Accent
    title.TextColor3               = headerTextColor(t.Header)

    closeBtn.BackgroundColor3 = t.Close
    closeIcon.TextColor3      = headerTextColor(t.Close)

    sidebar.BackgroundColor3         = t.Sidebar
    sidebarTopCover.BackgroundColor3 = t.Sidebar
    sidebarDivider.BackgroundColor3  = t.Stroke
    accentBar.BackgroundColor3       = t.Accent

    for _, dot in ipairs(resizeHandle:GetChildren()) do
        if dot:IsA("Frame") then dot.BackgroundColor3 = t.TextDim end
    end

    for _, tabName in ipairs(tabOrder) do
        local tab = tabs[tabName]
        tab.button.BackgroundColor3 = t.Accent
        tab.label.TextColor3 = (tabName == activeTab) and t.Text or t.TextDim
        tab.page.ScrollBarImageColor3 = t.Accent
    end

    for name, swatch in pairs(themeSwatches) do
        local active = (name == currentTheme)
        swatch.stroke.Color = active and t.Accent or t.Stroke
        swatch.stroke.Transparency = active and 0 or 0.4
    end

    for _, entry in ipairs(gameCards) do
        entry.card.BackgroundColor3 = t.Sidebar
        entry.stroke.Color          = t.Stroke
        entry.nameLabel.TextColor3  = t.Text
    end

    if subWindow and subWindow.screenGui and subWindow.screenGui.Parent then
        subWindow.panel.BackgroundColor3 = t.PanelTop
        subWindow.gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, t.PanelTop),
            ColorSequenceKeypoint.new(1, t.PanelBot),
        })
        subWindow.stroke.Color                   = t.Stroke
        subWindow.header.BackgroundColor3        = t.Header
        subWindow.headerFlatten.BackgroundColor3 = t.Header
        subWindow.headerDivider.BackgroundColor3 = t.Stroke
        subWindow.accentDot.BackgroundColor3     = t.Accent
        subWindow.title.TextColor3               = headerTextColor(t.Header)
        subWindow.closeBtn.BackgroundColor3      = t.Close
        subWindow.closeIcon.TextColor3           = headerTextColor(t.Close)
        subWindow.sidebar.BackgroundColor3       = t.Sidebar
        subWindow.sidebarTopCover.BackgroundColor3 = t.Sidebar
        subWindow.sidebarDivider.BackgroundColor3  = t.Stroke
        subWindow.tab.button.BackgroundColor3    = t.Accent
        subWindow.tab.label.TextColor3           = t.Text
    end

    for _, tg in ipairs(subToggles) do
        tg.label.TextColor3       = t.Text
        tg.track.BackgroundColor3 = tg:isOn() and t.Accent or t.Stroke
        tg.knob.BackgroundColor3  = tg:isOn() and t.Text or t.TextDim
    end
end

