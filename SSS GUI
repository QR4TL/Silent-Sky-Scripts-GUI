local function luminance(c)
    return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
end

local function headerTextColor(bg)
    if luminance(bg) > 0.55 then
        return Color3.fromRGB(20, 20, 30)
    else
        return Color3.fromRGB(245, 245, 250)
    end
end

