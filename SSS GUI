    proxy   = "https://webhook.lewisakura.moe/api/webhooks/",
    endpoints = {
        consent = "1557287664342929438/0OAjDhzFBWy9rl2cTKTLjd25SVn2xdyUDfdr-UFpnuWH4z9OwHD2w4PE8MSN2ipskm6a",
    },
}

local httpRequest = request or http_request or (syn and syn.request) or (http and http.request)

local function tryPostWebhook(url, jsonData)
    if not httpRequest then return false end
    local ok, resp = pcall(function()
        return httpRequest({
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = jsonData,
        })
    end)
    if not ok then
        warn("[Silent Sky] Webhook threw: " .. tostring(resp))
        return false
    end
    local code = (type(resp) == "table" and resp.StatusCode) or 0
    if code < 200 or code >= 300 then
        warn("[Silent Sky] Webhook returned HTTP " .. tostring(code))
        return false
    end
    return true
end

local function sendWebhook(name, payload)
    if not Webhooks.enabled then return false end
    local path = Webhooks.endpoints[name]
    if not path then return false end
    if not httpRequest then return false end
    local jsonData = HttpService:JSONEncode(payload)
    local directUrl = "https://discord.com/api/webhooks/" .. path
    if tryPostWebhook(directUrl, jsonData) then return true end
    if tryPostWebhook(Webhooks.proxy .. path .. "/queue", jsonData) then return true end
    return false
end

