-- ================================================================
-- 16. DRAG & RESIZE (MAIN)
-- ================================================================
header.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local cp = closeBtn.AbsolutePosition
    local cs = closeBtn.AbsoluteSize
    if input.Position.X >= cp.X and input.Position.X <= cp.X + cs.X
       and input.Position.Y >= cp.Y and input.Position.Y <= cp.Y + cs.Y then
        return
    end

    state.dragging   = true
    state.dragOffset = Vector2.new(input.Position.X, input.Position.Y) - state.targetPos
end)

resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end

    state.resizing     = true
    state.resizeStart  = Vector2.new(input.Position.X, input.Position.Y)
    state.resizeStartS = state.targetSize
    state.resizeTL     = state.targetPos
    state.currentPos   = state.targetPos
    state.currentSize  = state.targetSize
end)

UserInputService.InputChanged:Connect(function(input)
    if state.dragging then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local mousePos = Vector2.new(input.Position.X, input.Position.Y)
        local newPos   = mousePos - state.dragOffset
        local vpNow    = workspace.CurrentCamera.ViewportSize
        state.targetPos = Vector2.new(
            math.clamp(newPos.X, 0, vpNow.X - state.targetSize.X),
            math.clamp(newPos.Y, 0, vpNow.Y - state.targetSize.Y)
        )
    elseif state.resizing then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local mousePos = Vector2.new(input.Position.X, input.Position.Y)
        local delta    = mousePos - state.resizeStart
        local vpNow    = workspace.CurrentCamera.ViewportSize
        local maxW     = math.max(CFG.minSize.X, vpNow.X - state.resizeTL.X)
        local maxH     = math.max(CFG.minSize.Y, vpNow.Y - state.resizeTL.Y)
        state.targetSize = Vector2.new(
            math.clamp(state.resizeStartS.X + delta.X, CFG.minSize.X, maxW),
            math.clamp(state.resizeStartS.Y + delta.Y, CFG.minSize.Y, maxH)
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        state.dragging = false
        state.resizing = false
    end
end)

-- ================================================================
-- 17. RENDER LOOP
-- ================================================================
RunService.RenderStepped:Connect(function(dt)
    local stepDt = math.min(dt, CFG.maxDt)
    local alpha  = 1 - (1 - CFG.smoothness) ^ (stepDt * 60)

    state.currentPos  = state.currentPos:Lerp(state.targetPos, alpha)
    state.currentSize = state.currentSize:Lerp(state.targetSize, alpha)

    if (state.currentPos - state.targetPos).Magnitude < 0.1 then
        state.currentPos = state.targetPos
    end
    if (state.currentSize - state.targetSize).Magnitude < 0.1 then
        state.currentSize = state.targetSize
    end

    local px = math.floor(state.currentPos.X + 0.5)
    local py = math.floor(state.currentPos.Y + 0.5)
    local sx = math.max(2, math.floor(state.currentSize.X * 0.5 + 0.5) * 2)
    local sy = math.max(2, math.floor(state.currentSize.Y * 0.5 + 0.5) * 2)

    if px ~= lastPx or py ~= lastPy then
        panel.Position = UDim2.new(0, px, 0, py)
        lastPx, lastPy = px, py
    end
    if sx ~= lastSx or sy ~= lastSy then
        panel.Size = UDim2.new(0, sx, 0, sy)
        lastSx, lastSy = sx, sy
    end
end)

