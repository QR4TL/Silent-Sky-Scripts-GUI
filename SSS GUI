end)

resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
       and input.UserInputType ~= Enum.UserInputType.Touch then return end

    state.resizing     = true
    state.resizeStart  = Vector2.new(input.Position.X, input.Position.Y)
    state.resizeStartS = state.targetSize
    state.resizeTL     = state.targetPos
    state.currentPos   = state.targetPos
    state.currentSize  = state.targetSize
end)

UserInputService.InputChanged:Connect(function(input)
    if state.dragging then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local mousePos = Vector2.new(input.Position.X, input.Position.Y)
        local newPos   = mousePos - state.dragOffset
        local vpNow    = workspace.CurrentCamera.ViewportSize
        state.targetPos = Vector2.new(
            math.clamp(newPos.X, 0, vpNow.X - state.targetSize.X),
            math.clamp(newPos.Y, 0, vpNow.Y - state.targetSize.Y)
        )
    elseif state.resizing then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local mousePos = Vector2.new(input.Position.X, input.Position.Y)
        local delta    = mousePos - state.resizeStart
        local vpNow    = workspace.CurrentCamera.ViewportSize
        local maxW     = math.max(CFG.minSize.X, vpNow.X - state.resizeTL.X)
        local maxH     = math.max(CFG.minSize.Y, vpNow.Y - state.resizeTL.Y)
        state.targetSize = Vector2.new(
            math.clamp(state.resizeStartS.X + delta.X, CFG.minSize.X, maxW),
            math.clamp(state.resizeStartS.Y + delta.Y, CFG.minSize.Y, maxH)
        )
    elseif subState.dragging then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local mousePos = Vector2.new(input.Position.X, input.Position.Y)
        local newPos   = mousePos - subState.dragOffset
        local vpNow    = workspace.CurrentCamera.ViewportSize
        local subSize  = subWindow.panel.AbsoluteSize
        subState.targetPos = Vector2.new(
            math.clamp(newPos.X, 0, vpNow.X - subSize.X),
            math.clamp(newPos.Y, 0, vpNow.Y - subSize.Y)
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        state.dragging    = false
        state.resizing    = false
        subState.dragging = false
    end
end)

