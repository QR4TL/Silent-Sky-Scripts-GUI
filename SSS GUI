    track.BorderSizePixel  = 0
    track.Parent           = row

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent       = track

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 18, 0, 18)
    knob.Position         = UDim2.new(0, 2, 0.5, 0)
    knob.AnchorPoint      = Vector2.new(0, 0.5)
    knob.BackgroundColor3 = Palette.TextDim
    knob.BorderSizePixel  = 0
    knob.Parent           = track

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent       = knob

    local isOn = false

    local widget = {
        label = rowLabel,
        track = track,
        knob  = knob,
    }
    function widget:isOn() return isOn end

    local function setState(on, fireCallback)
        isOn = on
        local targetPos = on and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        TweenService:Create(knob,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                Position = targetPos,
                BackgroundColor3 = on and Palette.Text or Palette.TextDim,
            }
        ):Play()
        TweenService:Create(track, TweenInfo.new(0.15), {
            BackgroundColor3 = on and Palette.Accent or Palette.Stroke,
        }):Play()
        if fireCallback and onChange then onChange(on) end
    end

    track.MouseButton1Click:Connect(function()
        setState(not isOn, true)
    end)

    subToggles[#subToggles + 1] = widget
    return widget
end

