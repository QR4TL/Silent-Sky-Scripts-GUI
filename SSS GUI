local function selectTab(name)
    if not tabs[name] or activeTab == name then return end
    local prev = activeTab
    activeTab = name
    for _, tabName in ipairs(tabOrder) do
        tabs[tabName].setActive(tabName == name)
    end
    local targetY = tabs[name].centerY
    if prev == nil then
        accentBar.Position = UDim2.new(0, 0, 0, targetY)
        accentBar.BackgroundTransparency = 0
    else
        TweenService:Create(accentBar,
            TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
            { Position = UDim2.new(0, 0, 0, targetY) }
        ):Play()
    end
end

local function createTab(name)
    local index = #tabOrder
    tabOrder[#tabOrder + 1] = name

    local page = Instance.new("ScrollingFrame")
    page.Size                       = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency     = 1
    page.BorderSizePixel            = 0
    page.ScrollBarThickness         = 3
    page.ScrollBarImageTransparency = 0.5
    page.CanvasSize                 = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize        = Enum.AutomaticSize.Y
    page.Visible                    = false
    page.Parent                     = pageHolder

    local topY = CFG.tabTopPadding + index * (CFG.tabHeight + CFG.tabSpacing)
    local btn = Instance.new("TextButton")
    btn.Size                   = UDim2.new(1, -CFG.tabLeftPadding * 2, 0, CFG.tabHeight)
    btn.Position               = UDim2.new(0, CFG.tabLeftPadding, 0, topY)
    btn.BackgroundTransparency = 1
    btn.Text                   = ""
    btn.AutoButtonColor        = false
    btn.BorderSizePixel        = 0
    btn.Parent                 = sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent       = btn

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, -20, 1, 0)
    label.Position               = UDim2.new(0, 14, 0, 0)
    label.BackgroundTransparency = 1
    label.Text                   = name
    label.TextSize               = 13
    label.Font                   = Enum.Font.GothamMedium
    label.TextXAlignment         = Enum.TextXAlignment.Left
    label.Parent                 = btn

    local function setActive(isActive)
        page.Visible = isActive
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundTransparency = isActive and 0.85 or 1
        }):Play()
        TweenService:Create(label, TweenInfo.new(0.15), {
            TextColor3 = isActive and Palette.Text or Palette.TextDim
        }):Play()
    end

    tabs[name] = {
        button    = btn,
        label     = label,
        page      = page,
        setActive = setActive,
        centerY   = topY + CFG.tabHeight / 2,
    }

    btn.MouseButton1Click:Connect(function() selectTab(name) end)
    btn.MouseEnter:Connect(function()
        if activeTab == name then return end
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundTransparency = 0.9 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        if activeTab == name then return end
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
    end)

    return page
end

