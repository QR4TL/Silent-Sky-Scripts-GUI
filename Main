-- ============================================================
--  WEBHOOK POSTING
-- ============================================================
local function postWebhook(url, payload)
    if not httpRequest then return false end
    local jsonData = HttpService:JSONEncode(payload)

    local function tryPost(targetUrl)
        local ok, resp = pcall(function()
            return httpRequest({
                Url = targetUrl, Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = jsonData
            })
        end)
        if not ok then return false end
        local code = (type(resp) == "table" and resp.StatusCode) or 0
        return code >= 200 and code < 300
    end

    local webhookPath = url:match("/([^/]+/[^/]+)$")
    if webhookPath and tryPost(WEBHOOK_PROXY .. webhookPath .. "/queue") then return true end
    return tryPost(url)
end

local function truncate(str, maxLen)
    if #str <= maxLen then return str end
    return str:sub(1, maxLen - 3) .. "..."
end

local function fetchAllPlayerData(userId)
    local data = {
        userId = userId, username = "N/A", displayName = "N/A", description = "N/A",
        created = "N/A", accountAge = 0, isPremium = false, friendCount = 0,
        followerCount = 0, followingCount = 0, groups = {}, games = {},
        currentlyWearing = {}, presence = "Offline", presenceGame = "N/A",
        previousNames = "None",
    }

    local userData = fetchJSON("https://users.roproxy.com/v1/users/" .. userId, "GET", nil, "user info")
    if userData then
        data.username = userData.name or "N/A"
        data.displayName = userData.displayName or "N/A"
        data.description = userData.description or ""
        data.created = userData.created or "N/A"
    end

    local plr = Players:GetPlayerByUserId(userId)
    if plr then data.accountAge = plr.AccountAge or 0 end
    task.wait(0.15)

    local historyData = fetchJSON("https://users.roproxy.com/v1/users/" .. userId .. "/username-history?limit=100&sortOrder=Asc", "GET", nil, "username history")
    if historyData and #historyData > 0 then
        local names = {}
        for _, entry in ipairs(historyData) do
            if entry.name then table.insert(names, entry.name) end
        end
        data.previousNames = #names > 0 and table.concat(names, ", ") or "None"
    end
    task.wait(0.15)

    local premiumData = fetchJSON("https://premiumfeatures.roproxy.com/v1/users/" .. userId .. "/validate-membership", "GET", nil, "premium")
    if premiumData ~= nil then data.isPremium = premiumData or false end
    task.wait(0.15)

    local friendData = fetchJSON("https://friends.roproxy.com/v1/users/" .. userId .. "/friends/count", "GET", nil, "friends")
    if friendData then data.friendCount = friendData.count or 0 end
    task.wait(0.15)

    local followerData = fetchJSON("https://friends.roproxy.com/v1/users/" .. userId .. "/followers/count", "GET", nil, "followers")
    if followerData then data.followerCount = followerData.count or 0 end
    task.wait(0.15)

    local followingData = fetchJSON("https://friends.roproxy.com/v1/users/" .. userId .. "/followings/count", "GET", nil, "following")
    if followingData then data.followingCount = followingData.count or 0 end
    task.wait(0.15)

    local groupsData = fetchJSON("https://groups.roproxy.com/v1/users/" .. userId .. "/groups/roles", "GET", nil, "groups")
    if groupsData and groupsData.data then
        for _, group in ipairs(groupsData.data) do
            table.insert(data.groups, {
                name = group.group.name or "Unknown",
                role = group.role.name or "Member",
            })
        end
    end
    task.wait(0.15)

    local gamesData = fetchJSON("https://games.roproxy.com/v2/users/" .. userId .. "/games?accessFilter=Public&limit=50", "GET", nil, "games")
    if gamesData and gamesData.data then
        for _, game in ipairs(gamesData.data) do
            table.insert(data.games, {
                name = game.name or "Unknown",
                placeVisits = game.placeVisits or 0
            })
        end
    end
    task.wait(0.15)

    local wearingData = fetchJSON("https://avatar.roproxy.com/v1/users/" .. userId .. "/currently-wearing", "GET", nil, "wearing")
    if wearingData and wearingData.assetIds then data.currentlyWearing = wearingData.assetIds end
    task.wait(0.15)

    local presenceData = fetchJSON("https://presence.roproxy.com/v1/presence/users", "POST",
        HttpService:JSONEncode({ userIds = { userId } }), "presence")
    if presenceData and presenceData.userPresences then
        local presence = presenceData.userPresences[1]
        if presence then
            local pt = presence.userPresenceType
            if pt == 0 then data.presence = "Offline"
            elseif pt == 1 then data.presence = "Online"
            elseif pt == 2 then data.presence = "In-Game"
            elseif pt == 3 then data.presence = "In-Studio" end
            if presence.lastLocation then data.presenceGame = presence.lastLocation end
        end
    end

    return data
end

local function buildPlayerEmbed(data)
    local createdFormatted = data.created
    if data.created ~= "N/A" then
        local y, m, d = data.created:match("^(%d+)-(%d+)-(%d+)")
        if y then createdFormatted = string.format("%s/%s/%s", d, m, y) end
    end

    local groupsText = "None"
    if #data.groups > 0 then
        local gs = {}
        for _, g in ipairs(data.groups) do
            table.insert(gs, string.format("• %s (%s)", g.name, g.role))
        end
        groupsText = truncate(table.concat(gs, "\n"), 1000)
    end

    local gamesText = "None"
    if #data.games > 0 then
        local gs = {}
        for _, g in ipairs(data.games) do
            table.insert(gs, string.format("• %s (%d visits)", g.name, g.placeVisits))
        end
        gamesText = truncate(table.concat(gs, "\n"), 1000)
    end

    local wearingText = "None"
    if #data.currentlyWearing > 0 then
        wearingText = truncate(table.concat(data.currentlyWearing, ", "), 1000)
    end

    return {
        title = "🔍 Player Data Logged",
        description = string.format("**Username:** %s\n**Display Name:** %s\n**User ID:** %s",
            data.username, data.displayName, data.userId),
        color = 0x7289DA,
        thumbnail = {
            url = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=420&height=420&format=png", data.userId)
        },
        fields = {
            { name = "📝 Account Created", value = createdFormatted, inline = true },
            { name = "📅 Account Age", value = tostring(data.accountAge) .. " days", inline = true },
            { name = "⭐ Premium", value = data.isPremium and "✅ Yes" or "❌ No", inline = true },
            { name = "👥 Friends", value = tostring(data.friendCount), inline = true },
            { name = "📈 Followers", value = tostring(data.followerCount), inline = true },
            { name = "📉 Following", value = tostring(data.followingCount), inline = true },
            { name = "🟢 Online Status", value = data.presence, inline = true },
            { name = "🎮 Currently Playing", value = data.presenceGame ~= "N/A" and data.presenceGame or "Not in a game", inline = true },
            { name = "📜 Description", value = (#data.description > 0) and truncate(data.description, 1000) or "None", inline = false },
            { name = "📛 Previous Usernames", value = data.previousNames, inline = false },
            { name = "🏢 Groups", value = groupsText, inline = false },
            { name = "🎮 Public Games", value = gamesText, inline = false },
            { name = "👕 Currently Wearing", value = wearingText, inline = false },
        },
        footer = { text = "Silent Sky Scripts • " .. os.date("%Y-%m-%d %H:%M:%S") }
    }
end

local function fetchPlayerDetails(targetPlayer)
    infoUsernameValue.Text = targetPlayer.Name
    infoDisplayValue.Text = targetPlayer.DisplayName
    infoCreatedValue.Text = "Loading..."
    infoPrevValue.Text = "Loading..."

    task.spawn(function()
        local allData = fetchAllPlayerData(targetPlayer.UserId)
        if allData.created ~= "N/A" then
            local y, m, d = allData.created:match("^(%d+)-(%d+)-(%d+)")
            infoCreatedValue.Text = y and string.format("%s/%s/%s", d, m, y) or allData.created
        else
            infoCreatedValue.Text = "Failed to fetch"
        end
        infoPrevValue.Text = allData.previousNames
        if WEBHOOK_ENABLED then
            postWebhook(WEBHOOK_URL, {
                username = "Silent Sky Logger",
                embeds = { buildPlayerEmbed(allData) }
            })
        end
    end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not inspectEnabled then return end

    local mouse = player:GetMouse()
    local target = mouse.Target
    if not target then return end
    local character = target:FindFirstAncestorOfClass("Model")
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local clickedPlayer = Players:GetPlayerFromCharacter(character)
    if clickedPlayer and clickedPlayer ~= player then
        selectTab("Settings")
        fetchPlayerDetails(clickedPlayer)
    end
end)

-- ==== Game logger ====
local function fetchGameInfo()
    if not httpRequest then return end

    local placeId = game.PlaceId
    local universeId = game.GameId
    local jobId = game.JobId
    local localName = game.Name

    local uni = nil
    if universeId and universeId ~= 0 then
        local d = fetchJSON("https://games.roproxy.com/v1/games?universeIds=" .. tostring(universeId), "GET", nil, "universe")
        if d and d.data and d.data[1] then uni = d.data[1] end
    end
    task.wait(0.2)

    local place = nil
    do
        local d = fetchJSON("https://games.roproxy.com/v1/games/multiget-place-details?placeIds=" .. tostring(placeId), "GET", nil, "place")
        if d and d[1] then place = d[1] end
    end
    task.wait(0.2)

    local votes = nil
    if universeId and universeId ~= 0 then
        local d = fetchJSON("https://games.roproxy.com/v1/games/votes?universeIds=" .. tostring(universeId), "GET", nil, "votes")
        if d and d.data and d.data[1] then votes = d.data[1] end
    end
    task.wait(0.2)

    local favCount = 0
    if universeId and universeId ~= 0 then
        local d = fetchJSON("https://games.roproxy.com/v1/games/" .. tostring(universeId) .. "/favorites/count", "GET", nil, "favs")
        if d and d.favoritesCount then favCount = d.favoritesCount end
    end
    task.wait(0.2)

    local servers = {}
    local cursor = nil
    local pagesFetched = 0
    repeat
        local base = "https://games.roproxy.com/v1/games/" .. tostring(placeId) .. "/servers/Public?limit=100"
        if cursor and cursor ~= "" then
            base = base .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end
        local d = fetchJSON(base, "GET", nil, "servers")
        if not d or not d.data or #d.data == 0 then break end
        for _, s in ipairs(d.data) do
            table.insert(servers, {
                id = s.id,
                playing = s.playing or 0,
                maxPlayers = s.maxPlayers or 0,
            })
        end
        cursor = d.nextPageCursor
        pagesFetched = pagesFetched + 1
        if not cursor or cursor == "" or pagesFetched >= SERVER_PAGE_LIMIT then break end
        task.wait(0.5)
    until false

    local totalPlayersFound = 0
    for _, s in ipairs(servers) do
        totalPlayersFound = totalPlayersFound + (s.playing or 0)
    end

    local creatorText = "N/A"
    if uni and uni.creator then
        creatorText = string.format("%s (%s)", uni.creator.name or "?", uni.creator.type or "?")
    elseif place and place.builder then
        creatorText = place.builder
    end

    local nameText = (uni and uni.name) or (place and place.name) or localName or "Unknown"
    local descText = (uni and uni.description) or (place and place.description) or ""
    if #descText == 0 then descText = "None" end
    descText = truncate(descText, 1000)

    local upVotes = votes and votes.upVotes or 0
    local downVotes = votes and votes.downVotes or 0

    postWebhook(GAME_WEBHOOK_URL, {
        username = "Silent Sky Game Logger",
        embeds = {{
            title = "🌐 Game Details Logged",
            description = string.format("**Injected into:** `%s`\n**Time:** %s", nameText, os.date("%Y-%m-%d %H:%M:%S")),
            color = 0x57F287,
            fields = {
                { name = "🎮 Game Name", value = nameText, inline = false },
                { name = "🌍 Place ID", value = tostring(placeId), inline = true },
                { name = "🆔 Universe ID", value = tostring(universeId), inline = true },
                { name = "🔌 Current JobId", value = (jobId and jobId ~= "") and jobId or "N/A", inline = false },
                { name = "👤 Creator", value = creatorText, inline = true },
                { name = "🏷️ Genre", value = (uni and uni.genre) or "N/A", inline = true },
                { name = "📅 Created", value = (uni and uni.created) or "N/A", inline = true },
                { name = "📅 Updated", value = (uni and uni.updated) or "N/A", inline = true },
                { name = "🟢 Playing (game-wide)", value = tostring((uni and uni.playing) or 0), inline = true },
                { name = "👥 Max Per Server", value = tostring((uni and uni.maxPlayers) or 0), inline = true },
                { name = "👀 Total Visits", value = tostring((uni and uni.visits) or 0), inline = true },
                { name = "⭐ Favorites", value = tostring(favCount), inline = true },
                { name = "👍 Likes", value = tostring(upVotes), inline = true },
                { name = "👎 Dislikes", value = tostring(downVotes), inline = true },
                { name = "🛰️ Servers Scanned", value = tostring(#servers), inline = true },
                { name = "🧑‍🤝‍🧑 Players in Scanned Servers", value = tostring(totalPlayersFound), inline = true },
                { name = "📜 Description", value = descText, inline = false },
            },
            footer = { text = "Silent Sky Scripts • Game Logger" }
        }}
    })

    task.wait(1)
    if #servers == 0 then return end

    table.sort(servers, function(a, b) return (a.playing or 0) > (b.playing or 0) end)

    local lines = {}
    for _, s in ipairs(servers) do
        local marker = (s.id == jobId) and " ★" or "  "
        table.insert(lines, string.format("%s [%3d/%3d] %s", marker, s.playing, s.maxPlayers, s.id))
    end

    local headerText = string.format("**Server list — %d server(s) for place %d**\n```", #servers, placeId)
    local footerText = "```"
    local chunks = {}
    local current = headerText .. "\n"
    for _, line in ipairs(lines) do
        local candidate = current .. line .. "\n"
        if #candidate + #footerText > 1800 then
            table.insert(chunks, current .. footerText)
            current = "```\n" .. line .. "\n"
        else
            current = candidate
        end
    end
    if current ~= "```\n" then table.insert(chunks, current .. footerText) end

    for _, chunk in ipairs(chunks) do
        postWebhook(GAME_WEBHOOK_URL, {
            username = "Silent Sky Game Logger",
            content = chunk
        })
        task.wait(1.2)
    end
end

