local semicolonWatchUntil = 0
local floatSemicolonWatchUntil = 0

cmdBar:GetPropertyChangedSignal("Text"):Connect(function()
    if os.clock() <= semicolonWatchUntil and cmdBar.Text:sub(1, 1) == ";" then
        cmdBar.Text = cmdBar.Text:gsub("^;+", "")
    end
end)

floatBox:GetPropertyChangedSignal("Text"):Connect(function()
    if os.clock() <= floatSemicolonWatchUntil and floatBox.Text:sub(1, 1) == ";" then
        floatBox.Text = floatBox.Text:gsub("^;+", "")
    end
end)

local commandHistory = {}
local historyIndex = 0

local function pushHistory(cmd)
    if cmd == "" or commandHistory[#commandHistory] == cmd then return end
    table.insert(commandHistory, cmd)
    if #commandHistory > 100 then table.remove(commandHistory, 1) end
end

UserInputService.InputBegan:Connect(function(input)
    local focused = UserInputService:GetFocusedTextBox()
    if focused ~= cmdBar and focused ~= floatBox then return end
    if input.KeyCode == Enum.KeyCode.Up then
        if #commandHistory == 0 then return end
        historyIndex = math.max(1, historyIndex - 1)
        focused.Text = commandHistory[historyIndex]
        focused.CursorPosition = #focused.Text + 1
    elseif input.KeyCode == Enum.KeyCode.Down then
        if #commandHistory == 0 then return end
        historyIndex = math.min(#commandHistory + 1, historyIndex + 1)
        if historyIndex > #commandHistory then focused.Text = ""
        else focused.Text = commandHistory[historyIndex] end
        focused.CursorPosition = #focused.Text + 1
    elseif input.KeyCode == Enum.KeyCode.Tab then
        local text = focused.Text:lower()
        if text == "" then return end
        for canonical in pairs(commandDefs) do
            if canonical:sub(1, #text) == text then
                focused.Text = canonical
                focused.CursorPosition = #canonical + 1
                return
            end
        end
    end
end)

showCommandBar = function()
    if not commandsEnabled then return end
    if screenGui.Enabled then
        cmdBar.Text = ""
        cmdBar.Visible = true
        cmdBar:CaptureFocus()
        semicolonWatchUntil = os.clock() + 0.15
    else
        floatBox.Text = ""
        floatBar.Visible = true
        floatBox:CaptureFocus()
        floatSemicolonWatchUntil = os.clock() + 0.15
    end
end

hideCommandBar = function()
    if cmdBar.Visible then
        cmdBar.Visible = false
        cmdBar.Text = ""
        pcall(function() cmdBar:ReleaseFocus() end)
    end
    if floatBar.Visible then
        floatBar.Visible = false
        floatBox.Text = ""
        pcall(function() floatBox:ReleaseFocus() end)
    end
    semicolonWatchUntil = 0
    floatSemicolonWatchUntil = 0
end

local function handleBarInput(input, box, bar)
    bar.Visible = false
    box.Text = ""
    semicolonWatchUntil = 0
    floatSemicolonWatchUntil = 0
    pcall(function() box:ReleaseFocus() end)
    if input:match("%S") then
        pushHistory(input)
        parseAndRun(input)
    end
end

cmdBar.FocusLost:Connect(function(enterPressed)
    if enterPressed then handleBarInput(cmdBar.Text, cmdBar, cmdBar) else hideCommandBar() end
end)

floatBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then handleBarInput(floatBox.Text, floatBox, floatBar) else hideCommandBar() end
end)

