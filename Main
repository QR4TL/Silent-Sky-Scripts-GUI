-- ==== Fade system ====
local fadeTargets = {}
local windowVisible = true
local bubbleAlpha = 1
local bubbleAlphaTask = nil

local function tweenBubbleAlpha(target, duration)
    if bubbleAlphaTask then
        task.cancel(bubbleAlphaTask)
        bubbleAlphaTask = nil
    end
    if duration <= 0 then
        bubbleAlpha = target
        return
    end
    local startAlpha = bubbleAlpha
    local startTime = os.clock()
    bubbleAlphaTask = task.spawn(function()
        while true do
            local elapsed = os.clock() - startTime
            local p = math.clamp(elapsed / duration, 0, 1)
            local eased
            if p < 0.5 then
                eased = 2 * p * p
            else
                eased = 1 - ((-2 * p + 2) ^ 2) / 2
            end
            bubbleAlpha = startAlpha + (target - startAlpha) * eased
            if p >= 1 then break end
            RunService.Heartbeat:Wait()
        end
        bubbleAlpha = target
        bubbleAlphaTask = nil
    end)
end

local function applyWindowAlpha(alpha, duration, style)
    style = style or Enum.EasingStyle.Quart
    for _, t in ipairs(fadeTargets) do
        local targetValue = 1 - (1 - t.base) * alpha
        if duration <= 0 then
            t.obj[t.prop] = targetValue
        else
            TweenService:Create(t.obj, TweenInfo.new(duration, style), {
                [t.prop] = targetValue
            }):Play()
        end
    end
    tweenBubbleAlpha(alpha, duration)
end

local function collectFadeables(obj)
    for _, child in ipairs(obj:GetChildren()) do
        if child:IsA("Frame") or child:IsA("ScrollingFrame") then
            if child.BackgroundTransparency < 1 then
                fadeTargets[#fadeTargets+1] = {obj=child, prop="BackgroundTransparency", base=child.BackgroundTransparency}
            end
        elseif child:IsA("TextLabel") or child:IsA("TextButton") or child:IsA("TextBox") then
            if child.BackgroundTransparency < 1 then
                fadeTargets[#fadeTargets+1] = {obj=child, prop="BackgroundTransparency", base=child.BackgroundTransparency}
            end
            if child.TextTransparency < 1 then
                fadeTargets[#fadeTargets+1] = {obj=child, prop="TextTransparency", base=child.TextTransparency}
            end
        elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
            if child.BackgroundTransparency < 1 then
                fadeTargets[#fadeTargets+1] = {obj=child, prop="BackgroundTransparency", base=child.BackgroundTransparency}
            end
            if child.ImageTransparency < 1 then
                fadeTargets[#fadeTargets+1] = {obj=child, prop="ImageTransparency", base=child.ImageTransparency}
            end
        elseif child:IsA("UIStroke") then
            if child.Transparency < 1 then
                fadeTargets[#fadeTargets+1] = {obj=child, prop="Transparency", base=child.Transparency}
            end
        end
        collectFadeables(child)
    end
end

