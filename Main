local hubKeyCode = Enum.KeyCode.K

local function resolveKeyCode(name)
    name = tostring(name):upper():gsub("%s+", "")
    if name == "" then return nil end
    local map = {
        RALT = "RightAlt", LALT = "LeftAlt",
        RSHIFT = "RightShift", LSHIFT = "LeftShift",
        RCTRL = "RightControl", LCTRL = "LeftControl",
        RETURN = "Return", ENTER = "Return",
        ESC = "Escape", ESCAPE = "Escape",
        SPACE = "Space", TAB = "Tab",
    }
    local ok, code = pcall(function() return Enum.KeyCode[map[name] or name] end)
    if ok and code then return code end
    return nil
end

local capturedKey = nil

UserInputService.InputBegan:Connect(function(input)
    if UserInputService:GetFocusedTextBox() ~= hubKeybindBox then return end
    local kc = input.KeyCode
    if kc == Enum.KeyCode.Unknown or kc == Enum.KeyCode.Return or
       kc == Enum.KeyCode.KeypadEnter or kc == Enum.KeyCode.Escape then return end
    capturedKey = kc
    hubKeybindBox.Text = kc.Name:upper()
    task.defer(function()
        pcall(function() hubKeybindBox:ReleaseFocus() end)
    end)
end)

hubKeybindBox.FocusLost:Connect(function()
    if capturedKey then
        hubKeyCode = capturedKey
        hubKeybindBox.Text = capturedKey.Name:upper()
        capturedKey = nil
    else
        local code = resolveKeyCode(hubKeybindBox.Text)
        if code then
            hubKeyCode = code
            hubKeybindBox.Text = code.Name:upper()
        else
            hubKeybindBox.Text = hubKeyCode.Name:upper()
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode ~= hubKeyCode then return end

    local newVisible = not windowVisible
    windowVisible = newVisible

    if newVisible then
        screenGui.Enabled = true
        applyWindowAlpha(1, 0.35, Enum.EasingStyle.Quart)
    else
        applyWindowAlpha(0, 0.30, Enum.EasingStyle.Quart)
        task.delay(0.32, function()
            if not windowVisible then
                screenGui.Enabled = false
            end
        end)
        if cmdBar.Visible then
            cmdBar.Visible = false
            cmdBar.Text = ""
            pcall(function() cmdBar:ReleaseFocus() end)
        end
    end
end)

