local bubbles = {}

local function spawnBubble()
    local size = math.random(10, 65)
    local vp = workspace.CurrentCamera.ViewportSize
    local screenX = math.random(-BUBBLE_PADDING, vp.X + BUBBLE_PADDING)
    local screenY = math.random(-BUBBLE_PADDING, vp.Y + BUBBLE_PADDING)

    local frame = Instance.new("Frame")
    frame.Name = "Bubble"
    frame.Size = UDim2.new(0, size, 0, size)
    frame.Position = UDim2.new(0, 0, 0, 0)

    local greyValue = ({10, 20, 30})[math.random(1, 3)]
    frame.BackgroundColor3 = Color3.fromRGB(greyValue, greyValue, greyValue)
    frame.BackgroundTransparency = math.random(70, 88) / 100
    frame.BorderSizePixel = 0
    frame.ZIndex = 1
    frame.Parent = expandedView

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = frame

    local angle = math.random() * math.pi * 2
    local speed = BUBBLE_SPEED_MIN + math.random() * (BUBBLE_SPEED_MAX - BUBBLE_SPEED_MIN)

    bubbles[#bubbles + 1] = {
        frame = frame,
        screenPos = Vector2.new(screenX, screenY),
        vel = Vector2.new(math.cos(angle) * speed, math.sin(angle) * speed),
        size = size,
        greyValue = greyValue,
        tint = 0.25 + math.random() * 0.5,
    }
end

for i = 1, BUBBLE_COUNT do spawnBubble() end

local function recolorBubbles()
    local isOriginal = (currentThemeName == "Original")
    for _, b in ipairs(bubbles) do
        if isOriginal then
            local g = b.greyValue
            b.frame.BackgroundColor3 = Color3.fromRGB(g, g, g)
        else
            local base, accent, t = Theme.PanelBottom, Theme.Accent, b.tint
            b.frame.BackgroundColor3 = Color3.new(
                base.R + (accent.R - base.R) * t,
                base.G + (accent.G - base.G) * t,
                base.B + (accent.B - base.B) * t)
        end
    end
end

