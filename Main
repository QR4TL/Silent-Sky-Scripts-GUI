local function stripLeadingZeros(box)
    local text = box.Text
    local stripped = text:gsub("^0+(%d)", "%1")
    if stripped ~= text then box.Text = stripped end
end

local function makeRGBRow(yOffset, labelText)
    local rowLabel = Instance.new("TextLabel")
    rowLabel.Size = UDim2.new(0, 100, 0, 28)
    rowLabel.Position = UDim2.new(0, 14, 0, yOffset)
    rowLabel.BackgroundTransparency = 1
    rowLabel.Text = labelText
    rowLabel.TextColor3 = Color3.fromRGB(235, 235, 245)
    rowLabel.TextSize = 12
    rowLabel.Font = Enum.Font.Gotham
    rowLabel.TextXAlignment = Enum.TextXAlignment.Left
    rowLabel.Parent = customPanel

    local boxes = {}
    local placeholders = { "R", "G", "B" }
    for i = 1, 3 do
        local box = Instance.new("TextBox")
        box.Size = UDim2.new(0, 55, 0, 28)
        box.Position = UDim2.new(0, 100 + (i - 1) * 63, 0, yOffset)
        box.BackgroundColor3 = Theme.Content
        box.BackgroundTransparency = 0.3
        box.TextColor3 = Color3.fromRGB(235, 235, 245)
        box.PlaceholderColor3 = Color3.fromRGB(160, 160, 185)
        box.TextSize = 12
        box.Font = Enum.Font.Gotham
        box.PlaceholderText = placeholders[i]
        box.Text = ""
        box.ClearTextOnFocus = true
        box.BorderSizePixel = 0
        box.TextXAlignment = Enum.TextXAlignment.Center
        box.Parent = customPanel

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 4)
        c.Parent = box

        local stroke = Instance.new("UIStroke")
        stroke.Color = Theme.AccentSoft
        stroke.Thickness = 1
        stroke.Transparency = 0.6
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
        stroke.Parent = box

        box.FocusLost:Connect(function(enterPressed)
            if enterPressed then stripLeadingZeros(box) end
        end)

        boxes[i] = box
    end
    return rowLabel, boxes
end

