-- ============================================================
--  TOGGLES
-- ============================================================
local toggleRegistry = {}

local function computeToggleColors()
    local c, a = Theme.Content, Theme.Accent
    local isLight = luminance(c) > 0.5
    local offColor = isLight and offsetRGB(c, -50, -50, -45) or offsetRGB(c, 45, 45, 50)
    local onColor = a
    if isLight then
        if luminance(a) > 0.85 then onColor = offsetRGB(a, -70, -70, -70) end
    else
        if luminance(a) < luminance(offColor) + 0.1 then onColor = offsetRGB(a, 110, 110, 110) end
    end
    return offColor, onColor
end

local function createToggle(parent, opts)
    opts = opts or {}
    local labelText   = opts.label or "Toggle"
    local default     = opts.default or false
    local callback    = opts.callback
    local layoutOrder = opts.layoutOrder

    local row = Instance.new("TextButton")
    row.Name = (labelText:gsub("%s+", "")) .. "Toggle"
    row.Size = UDim2.new(1, 0, 0, 34)
    row.BackgroundTransparency = 1
    row.Text = ""
    row.AutoButtonColor = false
    row.LayoutOrder = layoutOrder or 0
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -50, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(235, 235, 245)
    lbl.TextSize = 13
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 36, 0, 20)
    pill.Position = UDim2.new(0, 180, 0.5, 0)
    pill.AnchorPoint = Vector2.new(0, 0.5)
    pill.BackgroundColor3 = Color3.fromRGB(80, 65, 150)
    pill.BorderSizePixel = 0
    pill.Parent = row

    local pillCorner = Instance.new("UICorner")
    pillCorner.CornerRadius = UDim.new(1, 0)
    pillCorner.Parent = pill

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 2, 0.5, 0)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
    knob.BorderSizePixel = 0
    knob.Parent = pill

    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob

    local state = default

    local function render(animate)
        local offColor, onColor = computeToggleColors()
        local targetKnobPos, targetPillColor
        if state then
            targetKnobPos = UDim2.new(0, 18, 0.5, 0)
            targetPillColor = onColor
        else
            targetKnobPos = UDim2.new(0, 2, 0.5, 0)
            targetPillColor = offColor
        end
        if animate then
            TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = targetKnobPos }):Play()
            TweenService:Create(pill, TweenInfo.new(0.15), { BackgroundColor3 = targetPillColor }):Play()
        else
            knob.Position = targetKnobPos
            pill.BackgroundColor3 = targetPillColor
        end
    end

    row.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        if callback then pcall(callback, state) end
    end)

    local entry = {
        label = lbl, pill = pill, knob = knob,
        getState = function() return state end,
        setState = function(v)
            state = v and true or false
            render(true)
            if callback then pcall(callback, state) end
        end,
        applyTheme = function()
            lbl.TextColor3 = Theme.Text
            local offColor, onColor = computeToggleColors()
            pill.BackgroundColor3 = state and onColor or offColor
        end,
    }

    table.insert(toggleRegistry, entry)
    render(false)
    if callback then pcall(callback, state) end
    return entry
end

-- ============================================================
--  COMMANDS
-- ============================================================
local commandsEnabled = true
local inspectEnabled  = false
local commandDefs = {}
local commandAliases = {}

local function registerCommand(canonical, handler)
    commandAliases[canonical:lower()] = canonical
    commandDefs[canonical] = handler
end

local function isAlive(p)
    local char = p.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function distanceTo(p)
    local char = player.Character
    local other = p.Character
    if not char or not other then return math.huge end
    local h1 = char:FindFirstChild("HumanoidRootPart")
    local h2 = other:FindFirstChild("HumanoidRootPart")
    if not h1 or not h2 then return math.huge end
    return (h1.Position - h2.Position).Magnitude
end

local function resolveSingle(query)
    query = query:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if query == "" then return {} end
    if query == "me" then return { player } end
    if query == "all" then return Players:GetPlayers() end
    if query == "others" then
        local t = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then table.insert(t, p) end
        end
        return t
    end
    if query == "random" then
        local pool = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then table.insert(pool, p) end
        end
        if #pool == 0 then return {} end
        return { pool[math.random(#pool)] }
    end
    if query == "nearest" then
        local best, bd = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local d = distanceTo(p)
                if d < bd then bd = d; best = p end
            end
        end
        return best and { best } or {}
    end
    if query == "alive" then
        local t = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if isAlive(p) then table.insert(t, p) end
        end
        return t
    end
    if query == "dead" then
        local t = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if not isAlive(p) then table.insert(t, p) end
        end
        return t
    end
    if query:sub(1, 1) == "@" then
        local name = query:sub(2)
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower() == name then return { p } end
        end
        return {}
    end
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower():find(query, 1, true) or p.DisplayName:lower():find(query, 1, true) then
            table.insert(t, p)
        end
    end
    return t
end

local function resolvePlayers(query)
    local out, seen = {}, {}
    for piece in query:gmatch("[^,]+") do
        for _, p in ipairs(resolveSingle(piece)) do
            if not seen[p] then seen[p] = true; table.insert(out, p) end
        end
    end
    return out
end

-- ============================================================
--  ESP / TRACERS
-- ============================================================
local espEnabled = false
local tracersEnabled = false
local espInstances = {}
local tracerInstances = {}
local ESP_COLOR = Color3.fromRGB(255, 60, 60)
local TRACER_COLOR = Color3.fromRGB(255, 60, 60)

local espFolder = Instance.new("Folder")
espFolder.Name = "SilentSkyESP"
espFolder.Parent = workspace

local hasDrawingAPI = false
pcall(function()
    if Drawing and Drawing.new then
        local test = Drawing.new("Line")
        test:Remove()
        hasDrawingAPI = true
    end
end)

local function createESP(plr)
    if plr == player or espInstances[plr] then return end
    local char = plr.Character
    if not char then return end
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_" .. plr.Name
    highlight.Adornee = char
    highlight.FillColor = ESP_COLOR
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = ESP_COLOR
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = espFolder
    espInstances[plr] = highlight
end

local function removeESP(plr)
    if espInstances[plr] then
        pcall(function() espInstances[plr]:Destroy() end)
        espInstances[plr] = nil
    end
end

local function createTracer(plr)
    if plr == player or tracerInstances[plr] or not hasDrawingAPI then return end
    local line = Drawing.new("Line")
    line.Thickness = 1.5
    line.Color = TRACER_COLOR
    line.Transparency = 1
    line.Visible = false
    tracerInstances[plr] = line
end

local function removeTracer(plr)
    if tracerInstances[plr] then
        pcall(function() tracerInstances[plr]:Remove() end)
        tracerInstances[plr] = nil
    end
end

local function refreshAllESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then createESP(p) end
    end
end

local function refreshAllTracers()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then createTracer(p) end
    end
end

local function hookPlayer(p)
    if p == player then return end
    p.CharacterAdded:Connect(function()
        task.wait(0.3)
        if espEnabled then createESP(p) end
        if tracersEnabled then createTracer(p) end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= player then hookPlayer(p) end
end

Players.PlayerAdded:Connect(function(p) if p ~= player then hookPlayer(p) end end)
Players.PlayerRemoving:Connect(function(p) removeESP(p); removeTracer(p) end)

RunService.RenderStepped:Connect(function()
    if not hasDrawingAPI or next(tracerInstances) == nil then return end
    local camera = workspace.CurrentCamera
    if not camera then return end
    local origin = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    for plr, line in pairs(tracerInstances) do
        local char = plr.Character
        if not char then
            line.Visible = false
        else
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then
                line.Visible = false
            else
                local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    line.From = origin
                    line.To = Vector2.new(screenPos.X, screenPos.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            end
        end
    end
end)

registerCommand("esp", function(args)
    if #args == 0 then
        espEnabled = not espEnabled
        if espEnabled then refreshAllESP(); return true, "ESP enabled" else
            for plr in pairs(espInstances) do removeESP(plr) end
            return true, "ESP disabled"
        end
    end
    local targets = resolvePlayers(table.concat(args, " "))
    if #targets == 0 then return false, "No players matched" end
    for _, p in ipairs(targets) do
        if p ~= player then
            if espInstances[p] then removeESP(p) else createESP(p) end
        end
    end
    return true, ("ESP toggled for %d"):format(#targets)
end)

registerCommand("unesp", function(args)
    if #args == 0 then
        espEnabled = false
        for plr in pairs(espInstances) do removeESP(plr) end
        return true, "ESP disabled"
    end
    local targets = resolvePlayers(table.concat(args, " "))
    for _, p in ipairs(targets) do removeESP(p) end
    return true, ("ESP removed for %d"):format(#targets)
end)

registerCommand("trace", function(args)
    if not hasDrawingAPI then return false, "Drawing API not available" end
    if #args == 0 then
        tracersEnabled = not tracersEnabled
        if tracersEnabled then refreshAllTracers(); return true, "Tracers enabled" else
            for plr in pairs(tracerInstances) do removeTracer(plr) end
            return true, "Tracers disabled"
        end
    end
    local targets = resolvePlayers(table.concat(args, " "))
    for _, p in ipairs(targets) do
        if p ~= player then
            if tracerInstances[p] then removeTracer(p) else createTracer(p) end
        end
    end
    return true, ("Tracers toggled for %d"):format(#targets)
end)

registerCommand("untrace", function(args)
    if not hasDrawingAPI then return false, "Drawing API not available" end
    if #args == 0 then
        tracersEnabled = false
        for plr in pairs(tracerInstances) do removeTracer(plr) end
        return true, "Tracers disabled"
    end
    local targets = resolvePlayers(table.concat(args, " "))
    for _, p in ipairs(targets) do removeTracer(p) end
    return true, ("Tracers removed for %d"):format(#targets)
end)

local function parseAndRun(input)
    if not commandsEnabled then return false, "Commands are disabled" end
    input = input:gsub("^%s+", ""):gsub("%s+$", "")
    if input == "" then return false end
    if input:find("\\") then
        for piece in input:gmatch("[^\\]+") do parseAndRun(piece) end
        return true
    end
    local lc, ld, lcmd = input:match("^(%S+)%^(%S+)%^(.+)$")
    if lc and lcmd then
        task.spawn(function()
            local n = (lc:lower() == "inf") and math.huge or tonumber(lc)
            local d = tonumber(ld) or 0
            if not n then return end
            for _ = 1, n do
                if not commandsEnabled then break end
                parseAndRun(lcmd)
                if d > 0 then task.wait(d) end
            end
        end)
        return true
    end
    local tokens = {}
    for word in input:gmatch("%S+") do tokens[#tokens + 1] = word end
    if #tokens == 0 then return false end
    local canonical = commandAliases[tokens[1]:lower()]
    if not canonical then return false, "Unknown command: " .. tokens[1] end
    local args = {}
    for i = 2, #tokens do args[#args + 1] = tokens[i] end
    return commandDefs[canonical](args)
end

