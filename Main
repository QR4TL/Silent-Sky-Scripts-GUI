-- ============================================================
--  LOADING SCREEN
-- ============================================================
local function showLoadingScreen()
    local DURATION = 5.0

    local loadGui = Instance.new("ScreenGui")
    loadGui.Name = "SilentSkyLoading"
    loadGui.ResetOnSpawn = false
    loadGui.IgnoreGuiInset = true
    loadGui.DisplayOrder = 2147483647
    loadGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    loadGui.Parent = playerGui

    local backdrop = Instance.new("Frame")
    backdrop.Size = UDim2.new(1, 0, 1, 0)
    backdrop.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    backdrop.BorderSizePixel = 0
    backdrop.BackgroundTransparency = 1
    backdrop.Parent = loadGui

    local backdropGradient = Instance.new("UIGradient")
    backdropGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 150)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 150, 200)),
    })
    backdropGradient.Rotation = 135
    backdropGradient.Parent = backdrop

    local particles = {}
    local PARTICLE_COUNT = 200

    local function spawnParticle()
        local size = math.random(8, 45)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, size, 0, size)
        frame.BackgroundColor3 = Color3.fromRGB(
            math.random(220, 255), math.random(220, 255), math.random(220, 255))
        frame.BackgroundTransparency = math.random(40, 85) / 100
        frame.BorderSizePixel = 0
        frame.ZIndex = 2
        frame.Parent = backdrop

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(1, 0)
        corner.Parent = frame

        local vp = workspace.CurrentCamera.ViewportSize
        particles[#particles + 1] = {
            frame = frame,
            pos = Vector2.new(math.random(0, vp.X), math.random(0, vp.Y)),
            vel = Vector2.new((math.random() - 0.5) * 40, -math.random(20, 60)),
            size = size,
            phase = math.random() * math.pi * 2,
            baseTransparency = frame.BackgroundTransparency,
        }
    end

    for i = 1, PARTICLE_COUNT do spawnParticle() end

    local centerContainer = Instance.new("Frame")
    centerContainer.Size = UDim2.new(0, 500, 0, 400)
    centerContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
    centerContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    centerContainer.BackgroundTransparency = 1
    centerContainer.ZIndex = 5
    centerContainer.Parent = loadGui

    local logoImage = Instance.new("ImageLabel")
    logoImage.Size = UDim2.new(0, 260, 0, 260)
    logoImage.Position = UDim2.new(0.5, 0, 0, 15)
    logoImage.AnchorPoint = Vector2.new(0.5, 0)
    logoImage.BackgroundTransparency = 1
    logoImage.Image = "rbxassetid://124114118664372"
    logoImage.ZIndex = 8
    logoImage.Parent = centerContainer

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.Position = UDim2.new(0, 0, 0, 285)
    title.BackgroundTransparency = 1
    title.Text = "SILENT SKY SCRIPTS"
    title.TextColor3 = Color3.fromRGB(0, 0, 0)
    title.TextSize = 30
    title.Font = Enum.Font.GothamBlack
    title.TextTransparency = 1
    title.ZIndex = 8
    title.Parent = centerContainer

    local titleStroke = Instance.new("UIStroke")
    titleStroke.Color = Color3.fromRGB(255, 255, 255)
    titleStroke.Thickness = 2
    titleStroke.Transparency = 0.5
    titleStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    titleStroke.Parent = title

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, 0, 0, 18)
    statusLabel.Position = UDim2.new(0, 0, 0, 335)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "Initialising..."
    statusLabel.TextColor3 = Color3.fromRGB(40, 40, 40)
    statusLabel.TextSize = 14
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextTransparency = 1
    statusLabel.ZIndex = 8
    statusLabel.Parent = centerContainer

    local barHolder = Instance.new("Frame")
    barHolder.Size = UDim2.new(0, 340, 0, 6)
    barHolder.Position = UDim2.new(0.5, 0, 0, 370)
    barHolder.AnchorPoint = Vector2.new(0.5, 0)
    barHolder.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    barHolder.BackgroundTransparency = 1
    barHolder.BorderSizePixel = 0
    barHolder.ZIndex = 8
    barHolder.Parent = centerContainer

    local barHolderCorner = Instance.new("UICorner")
    barHolderCorner.CornerRadius = UDim.new(1, 0)
    barHolderCorner.Parent = barHolder

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    barFill.BorderSizePixel = 0
    barFill.ZIndex = 9
    barFill.Parent = barHolder

    local barFillCorner = Instance.new("UICorner")
    barFillCorner.CornerRadius = UDim.new(1, 0)
    barFillCorner.Parent = barFill

    local percentLabel = Instance.new("TextLabel")
    percentLabel.Size = UDim2.new(0, 60, 0, 18)
    percentLabel.Position = UDim2.new(1, 12, 0.5, 0)
    percentLabel.AnchorPoint = Vector2.new(0, 0.5)
    percentLabel.BackgroundTransparency = 1
    percentLabel.Text = "0%"
    percentLabel.TextColor3 = Color3.fromRGB(0, 0, 0)
    percentLabel.TextSize = 14
    percentLabel.Font = Enum.Font.GothamBold
    percentLabel.TextXAlignment = Enum.TextXAlignment.Left
    percentLabel.TextTransparency = 1
    percentLabel.ZIndex = 8
    percentLabel.Parent = barHolder

    local fadeInInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(backdrop, fadeInInfo, {BackgroundTransparency = 0}):Play()
    TweenService:Create(title, fadeInInfo, {TextTransparency = 0}):Play()
    TweenService:Create(statusLabel, fadeInInfo, {TextTransparency = 0}):Play()
    TweenService:Create(barHolder, fadeInInfo, {BackgroundTransparency = 0.2}):Play()
    TweenService:Create(percentLabel, fadeInInfo, {TextTransparency = 0}):Play()
    TweenService:Create(logoImage, fadeInInfo, {ImageTransparency = 0}):Play()

    local particleConnection
    particleConnection = RunService.RenderStepped:Connect(function(dt)
        if not loadGui.Parent then
            if particleConnection then particleConnection:Disconnect() end
            return
        end
        local vp = workspace.CurrentCamera.ViewportSize
        local t = os.clock()
        for _, p in ipairs(particles) do
            p.pos = p.pos + p.vel * dt
            if p.pos.Y < -20 then
                p.pos = Vector2.new(math.random(0, vp.X), vp.Y + 20)
            end
            if p.pos.X < -20 then p.pos = Vector2.new(vp.X + 20, p.pos.Y) end
            if p.pos.X > vp.X + 20 then p.pos = Vector2.new(-20, p.pos.Y) end
            p.frame.Position = UDim2.new(0, p.pos.X, 0, p.pos.Y)
            local twinkle = 0.5 + 0.5 * math.sin(t * 2 + p.phase)
            p.frame.BackgroundTransparency = math.clamp(
                p.baseTransparency + (1 - twinkle) * 0.3, 0, 1)
        end
    end)

    local statusMessages = {
        { t = 0.00, text = "Initialising..." },
        { t = 0.18, text = "Loading modules..." },
        { t = 0.36, text = "Preparing interface..." },
        { t = 0.54, text = "Connecting to services..." },
        { t = 0.72, text = "Syncing player data..." },
        { t = 0.88, text = "Finalising..." },
        { t = 1.00, text = "Ready." },
    }

    local startTime = os.clock()
    local lastStatusIndex = 0

    while true do
        local elapsed = os.clock() - startTime
        local progress = math.clamp(elapsed / DURATION, 0, 1)
        local eased = 1 - (1 - progress) ^ 2
        barFill.Size = UDim2.new(eased, 0, 1, 0)
        percentLabel.Text = string.format("%d%%", math.floor(eased * 100))
        for i = #statusMessages, 1, -1 do
            if progress >= statusMessages[i].t and i > lastStatusIndex then
                lastStatusIndex = i
                statusLabel.Text = statusMessages[i].text
                break
            end
        end
        if progress >= 1 then break end
        RunService.Heartbeat:Wait()
    end

    task.wait(0.35)

    if particleConnection then
        particleConnection:Disconnect()
        particleConnection = nil
    end

    local FADE_OUT_TIME = 1.2
    local fadeOutInfo = TweenInfo.new(FADE_OUT_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
    TweenService:Create(backdrop,     fadeOutInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(title,        fadeOutInfo, {TextTransparency       = 1}):Play()
    TweenService:Create(statusLabel,  fadeOutInfo, {TextTransparency       = 1}):Play()
    TweenService:Create(barHolder,    fadeOutInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(barFill,      fadeOutInfo, {BackgroundTransparency = 1}):Play()
    TweenService:Create(percentLabel, fadeOutInfo, {TextTransparency       = 1}):Play()
    TweenService:Create(logoImage,    fadeOutInfo, {ImageTransparency      = 1}):Play()
    for _, p in ipairs(particles) do
        TweenService:Create(p.frame, fadeOutInfo, {BackgroundTransparency = 1}):Play()
    end
    task.wait(FADE_OUT_TIME + 0.05)
    loadGui:Destroy()
end

showLoadingScreen()

-- ============================================================
--  HTTP FETCHER
-- ============================================================
local function hostFallbacks(url)
    local direct = url:gsub("%.roproxy%.com", ".roblox.com")
    if direct ~= url then return { url, direct } end
    return { url }
end

local function tryRequestJSON(url, method, body)
    if not httpRequest then return nil, "no httpRequest" end
    local ok, resp = pcall(function()
        return httpRequest({ Url = url, Method = method or "GET",
            Headers = { ["Content-Type"] = "application/json" }, Body = body })
    end)
    if not ok then return nil, "threw: " .. tostring(resp) end
    local code = (type(resp) == "table" and resp.StatusCode) or 0
    if code ~= 200 then return nil, "HTTP " .. tostring(code) end
    local decOk, dec = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    if not decOk then return nil, "decode failed" end
    return dec
end

local function fetchJSON(url, method, body, label)
    for _, u in ipairs(hostFallbacks(url)) do
        local dec = tryRequestJSON(u, method, body)
        if dec ~= nil then return dec end
    end
    if DEBUG_HTTP then
        warn(("[Silent Sky] %s failed"):format(label or "fetchJSON"))
    end
    return nil
end

-- ============================================================
--  HELPERS
-- ============================================================
local function luminance(c) return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B end
local function deriveTextColors(bg)
    if luminance(bg) > 0.5 then
        return Color3.fromRGB(15, 15, 15), Color3.fromRGB(80, 80, 80)
    else
        return Color3.fromRGB(245, 245, 245), Color3.fromRGB(180, 180, 180)
    end
end

