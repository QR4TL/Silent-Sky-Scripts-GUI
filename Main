local tabs = {}
local tabOrder = {}
local activeTab = nil

local function selectTab(name)
    if not tabs[name] or activeTab == name then return end
    local previous = activeTab
    activeTab = name
    for _, tabName in ipairs(tabOrder) do
        if tabs[tabName] then tabs[tabName].setActive(tabName == name) end
    end
    local targetPosition = UDim2.new(0, 5, 0, tabs[name].centerY)
    if previous == nil then
        accentBar.Position = targetPosition
        TweenService:Create(accentBar, TweenInfo.new(0.25), { BackgroundTransparency = 0 }):Play()
    else
        TweenService:Create(accentBar, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = targetPosition }):Play()
    end
end

local function createTab(name, opts)
    opts = opts or {}
    local index = #tabOrder
    tabOrder[#tabOrder + 1] = name

    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = Theme.Accent
    page.ScrollBarImageTransparency = 0.5
    page.CanvasSize = UDim2.new(0, 0, 0, 500)
    page.Visible = false
    page.Parent = pageHolder

    local pageTitle = Instance.new("TextLabel")
    pageTitle.Name = "Title"
    pageTitle.Size = UDim2.new(1, 0, 0, 22)
    pageTitle.BackgroundTransparency = 1
    pageTitle.Text = name
    pageTitle.TextColor3 = Color3.fromRGB(235, 235, 245)
    pageTitle.TextSize = 16
    pageTitle.Font = Enum.Font.GothamBold
    pageTitle.TextXAlignment = Enum.TextXAlignment.Left
    pageTitle.Parent = page

    if opts.hint ~= false then
        local pageHint = Instance.new("TextLabel")
        pageHint.Name = "Hint"
        pageHint.Size = UDim2.new(1, 0, 0, 18)
        pageHint.Position = UDim2.new(0, 0, 0, 26)
        pageHint.BackgroundTransparency = 1
        pageHint.Text = "Nothing here yet."
        pageHint.TextColor3 = Color3.fromRGB(160, 160, 185)
        pageHint.TextSize = 12
        pageHint.Font = Enum.Font.Gotham
        pageHint.TextXAlignment = Enum.TextXAlignment.Left
        pageHint.Parent = page
    end

    local topY = index * TAB_SPACING + TAB_TOP
    local btn = Instance.new("TextButton")
    btn.Name = name .. "Tab"
    btn.Size = UDim2.new(1, -8, 0, TAB_H)
    btn.Position = UDim2.new(0, 4, 0, topY)
    btn.BackgroundColor3 = Theme.Content
    btn.BackgroundTransparency = 0.75
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    btn.ZIndex = 3
    btn.Parent = sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Size = UDim2.new(1, -22, 1, 0)
    label.Position = UDim2.new(0, 16, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(160, 160, 185)
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = btn

    local function setActive(isActive)
        page.Visible = isActive
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundTransparency = isActive and 0.2 or 0.75 }):Play()
        TweenService:Create(label, TweenInfo.new(0.15), { TextColor3 = isActive and Theme.Text or Theme.TextDim }):Play()
    end

    tabs[name] = {
        button = btn, label = label, page = page,
        pageTitle = pageTitle, setActive = setActive, centerY = topY + TAB_H / 2,
    }

    btn.MouseButton1Click:Connect(function() selectTab(name) end)
    btn.MouseEnter:Connect(function()
        if activeTab == name then return end
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.55}):Play()
    end)
    btn.MouseLeave:Connect(function()
        if activeTab == name then return end
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.75}):Play()
    end)

    return page
end

