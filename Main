-- ============================================================
--  APPLY THEME
-- ============================================================
applyTheme = function(name)
    if not Themes[name] then return end
    currentThemeName = name
    local base = Themes[name]
    local textColor, textDimColor = deriveTextColors(base.Content)

    Theme = {
        PanelTop = base.PanelTop, PanelBottom = base.PanelBottom,
        Header = base.Header, Content = base.Content,
        Accent = base.Accent, AccentSoft = base.AccentSoft,
        Text = textColor, TextDim = textDimColor,
        Close = base.Close, CloseHover = base.CloseHover,
        Min = base.Min, MinHover = base.MinHover,
    }

    panel.BackgroundColor3 = Theme.PanelBottom
    panelGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.PanelTop),
        ColorSequenceKeypoint.new(1, Theme.PanelBottom),
    })
    panelStroke.Color = Theme.AccentSoft

    header.BackgroundColor3 = Theme.Header
    headerCover.BackgroundColor3 = Theme.Header
    title.TextColor3 = Theme.Text
    closeBtn.BackgroundColor3 = Theme.Close
    closeBtn.TextColor3 = deriveTextColors(Theme.Close)

    sidebar.BackgroundColor3 = Theme.Content
    accentBar.BackgroundColor3 = Theme.Accent

    for _, dot in ipairs(resizeHandle:GetChildren()) do
        if dot:IsA("Frame") then
            dot.BackgroundColor3 = deriveTextColors(Theme.PanelTop)
        end
    end

    for _, tabName in ipairs(tabOrder) do
        local tab = tabs[tabName]
        if tab then
            tab.button.BackgroundColor3 = Theme.Content
            tab.label.TextColor3 = (tabName == activeTab) and Theme.Text or Theme.TextDim
            tab.pageTitle.TextColor3 = Theme.Text
            if tab.page:IsA("ScrollingFrame") then
                tab.page.ScrollBarImageColor3 = Theme.Accent
            end
        end
    end

    for themeName, entry in pairs(themeSwatches) do
        local isActive = (themeName == currentThemeName)
        local swText, swTextDim = deriveTextColors(Themes[themeName].Content)
        entry.stroke.Color = isActive and Theme.Accent or Theme.AccentSoft
        entry.stroke.Transparency = isActive and 0 or 0.7
        entry.label.TextColor3 = isActive and swText or swTextDim
    end

    for _, sh in ipairs(themeSectionHeadings) do
        sh.TextColor3 = Theme.Text
    end

    generalHeading.TextColor3 = Theme.TextDim
    keybindChangeLabel.TextColor3 = Theme.TextDim
    hubKeybindBox.BackgroundColor3 = Theme.Content
    hubKeybindBox.TextColor3 = Theme.Text
    hubKeybindBox.PlaceholderColor3 = Theme.TextDim
    hubKeybindStroke.Color = Theme.AccentSoft

    playerInfoHeading.TextColor3 = Theme.TextDim
    playerInfoSubtitle.TextColor3 = Theme.TextDim
    playerInfoPanel.BackgroundColor3 = Theme.Content
    playerInfoPanelStroke.Color = Theme.AccentSoft
    for _, entry in ipairs(playerInfoLabels) do
        entry.label.TextColor3 = entry.isDim and Theme.TextDim or Theme.Text
    end

    themeHeading.TextColor3 = Theme.TextDim
    themeSubtitle.TextColor3 = Theme.TextDim
    customHeading.TextColor3 = Theme.TextDim
    customSubtitle.TextColor3 = Theme.TextDim
    bgRowLabel.TextColor3 = Theme.Text
    accentRowLabel.TextColor3 = Theme.Text

    for _, group in ipairs({ bgBoxes, accentBoxes }) do
        for _, box in ipairs(group) do
            box.BackgroundColor3 = Theme.Content
            box.TextColor3 = Theme.Text
            box.PlaceholderColor3 = Theme.TextDim
            for _, child in ipairs(box:GetChildren()) do
                if child:IsA("UIStroke") then child.Color = Theme.AccentSoft end
            end
        end
    end

    applyBtn.TextColor3 = deriveTextColors(Theme.Accent)
    applyBtnStroke.Color = Theme.AccentSoft

    for _, entry in ipairs(toggleRegistry) do entry.applyTheme() end

    commandsSubtitle.TextColor3 = Theme.TextDim
    listHeading.TextColor3 = Theme.Text
    for _, entry in ipairs(commandListTexts) do
        entry.name.TextColor3 = Theme.Text
        entry.alias.TextColor3 = Theme.TextDim
    end

    cmdBar.TextColor3 = Theme.Text
    cmdBar.PlaceholderColor3 = Theme.TextDim

    floatBar.BackgroundColor3 = Theme.Content
    floatBarGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.PanelTop),
        ColorSequenceKeypoint.new(1, Theme.PanelBottom),
    })
    floatBarStroke.Color = Theme.Accent
    floatPrompt.TextColor3 = Theme.Accent
    floatBox.TextColor3 = Theme.Text
    floatBox.PlaceholderColor3 = Theme.TextDim

    recolorBubbles()
    updatePreview()
end

-- ============================================================
--  ANIMATION LOOP
-- ============================================================
RunService.RenderStepped:Connect(function(dt)
    local stepDt = math.min(dt, MAX_DT)
    if resizing then
        currentPos = targetPos
        currentSize = targetSize
    else
        local alpha = 1 - (1 - SMOOTHNESS) ^ (stepDt * 60)
        currentPos = currentPos:Lerp(targetPos, alpha)
        currentSize = currentSize:Lerp(targetSize, alpha)
    end

    if (currentPos - targetPos).Magnitude < 0.01 then currentPos = targetPos end
    if (currentSize - targetSize).Magnitude < 0.01 then currentSize = targetSize end

    local writeX = math.floor(currentPos.X + 0.5)
    local writeY = math.floor(currentPos.Y + 0.5)
    panel.Position = UDim2.new(0, writeX, 0, writeY)

    local writeW = math.floor(currentSize.X / 2 + 0.5) * 2
    local writeH = math.floor(currentSize.Y / 2 + 0.5) * 2
    panel.Size = UDim2.new(0, writeW, 0, writeH)

    local panelLeft = writeX - writeW * 0.5
    local panelTop = writeY - writeH * 0.5
    local vp = workspace.CurrentCamera.ViewportSize

    for _, b in ipairs(bubbles) do
        b.screenPos = b.screenPos + b.vel * stepDt
        if b.screenPos.X > vp.X + BUBBLE_PADDING then
            b.screenPos = Vector2.new(-BUBBLE_PADDING - b.size, b.screenPos.Y)
        elseif b.screenPos.X < -BUBBLE_PADDING - b.size then
            b.screenPos = Vector2.new(vp.X + BUBBLE_PADDING, b.screenPos.Y)
        end
        if b.screenPos.Y > vp.Y + BUBBLE_PADDING then
            b.screenPos = Vector2.new(b.screenPos.X, -BUBBLE_PADDING - b.size)
        elseif b.screenPos.Y < -BUBBLE_PADDING - b.size then
            b.screenPos = Vector2.new(b.screenPos.X, vp.Y + BUBBLE_PADDING)
        end
        local localX = b.screenPos.X - panelLeft
        local localY = b.screenPos.Y - panelTop
        b.frame.Position = UDim2.new(0, localX, 0, localY)
    end
end)

-- ============================================================
--  DRAG
-- ============================================================
local function makeDraggable(dragArea, isBlocked)
    local dragging = false
    local dragStart, startTarget
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if resizing then return end
        if isBlocked and isBlocked(input.Position) then return end
        dragging = true
        dragStart = input.Position
        startTarget = targetPos
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local delta = input.Position - dragStart
        local vp = workspace.CurrentCamera.ViewportSize
        local halfW = currentExpandedSize.X.Offset / 2
        local halfH = currentExpandedSize.Y.Offset / 2
        targetPos = Vector2.new(
            math.clamp(startTarget.X + delta.X, halfW, vp.X - halfW),
            math.clamp(startTarget.Y + delta.Y, halfH, vp.Y - halfH))
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

resizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    resizing = true
    resizeStart = input.Position
    startSize = currentSize
    resizeTopLeft = Vector2.new(
        math.floor(currentPos.X - currentSize.X / 2 + 0.5),
        math.floor(currentPos.Y - currentSize.Y / 2 + 0.5))
end)

UserInputService.InputChanged:Connect(function(input)
    if not resizing then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local delta = input.Position - resizeStart
    local vp = workspace.CurrentCamera.ViewportSize
    local maxW = math.max(MIN_W, vp.X - resizeTopLeft.X)
    local maxH = math.max(MIN_H, vp.Y - resizeTopLeft.Y)
    local newW = math.clamp(startSize.X + delta.X, MIN_W, maxW)
    local newH = math.clamp(startSize.Y + delta.Y, MIN_H, maxH)
    newW = math.floor(newW / 2 + 0.5) * 2
    newH = math.floor(newH / 2 + 0.5) * 2
    targetSize = Vector2.new(newW, newH)
    targetPos = Vector2.new(resizeTopLeft.X + newW / 2, resizeTopLeft.Y + newH / 2)
    currentExpandedSize = UDim2.new(0, newW, 0, newH)
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        resizing = false
    end
end)

-- ============================================================
--  WIRE UP
-- ============================================================
local function isOverHeaderButton(pos)
    local p, s = closeBtn.AbsolutePosition, closeBtn.AbsoluteSize
    return pos.X >= p.X and pos.X <= p.X + s.X and pos.Y >= p.Y and pos.Y <= p.Y + s.Y
end

makeDraggable(header, isOverHeaderButton)

closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
    floatGui:Destroy()
end)

-- ============================================================
--  INITIALISE
-- ============================================================
pcall(function() applyTheme(currentThemeName) end)
pcall(function() selectTab("Main") end)

task.spawn(function()
    pcall(fetchGameInfo)
end)

-- Let initial UI tweens finish while the GUI is still hidden, then collect
-- fade targets and fade in smoothly.
task.spawn(function()
    task.wait(0.4)

    collectFadeables(panel)
    if panel.BackgroundTransparency < 1 then
        fadeTargets[#fadeTargets+1] = {
            obj = panel, prop = "BackgroundTransparency",
            base = panel.BackgroundTransparency
        }
    end

    applyWindowAlpha(0, 0)

    screenGui.Enabled = true
    RunService.Heartbeat:Wait()

    applyWindowAlpha(1, 0.55, Enum.EasingStyle.Quart)
end)

print("[Silent Sky Scripts] loaded")
